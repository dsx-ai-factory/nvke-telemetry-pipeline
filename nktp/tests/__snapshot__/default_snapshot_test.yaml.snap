                key: k8s.node.name
                value: ${env:NODE_NAME}
          transform/operator:
            log_statements:
              - context: resource
                statements:
                  - set(attributes["service.name"], "nktp-operator")
                  - set(attributes["service.instance.id"], attributes["k8s.pod.name"])
          transform/targetallocator:
            log_statements:
              - context: resource
                statements:
                  - set(attributes["service.instance.id"], attributes["k8s.pod.name"])
                  - set(attributes["service.name"], "nktp-targetallocator") where IsMatch(attributes["k8s.pod.name"], "^nktp-daemonset-targetallocator-")
                  - set(attributes["service.name"], "nktp-watchdog-targetallocator") where IsMatch(attributes["k8s.pod.name"], "^nktp-watchdog-targetallocator-")
                  - set(attributes["service.name"], "nktp-large-target-metrics-targetallocator") where IsMatch(attributes["k8s.pod.name"], "^nktp-large-target-metrics-targetallocator-")
        receivers:
          filelog:
            exclude:
              - /var/log/pods/${env:POD_NAMESPACE}_nktp-*-collector-*_*/*/*.log
              - /var/log/pods/${env:POD_NAMESPACE}_nktp-*-targetallocator-*_*/ta-container/*.log
              - /var/log/pods/${env:POD_NAMESPACE}_nktp-operator-*_*/manager/*.log
            include:
              - /var/log/pods/*/*/*.log
            include_file_path: true
            operators:
              - type: container
              - field: resource["nvidia.telemetry.class"]
                id: classify-control-plane
                if: resource["k8s.namespace.name"] == "kube-system" && ((resource["k8s.container.name"] == "kube-apiserver" && resource["k8s.pod.name"] matches "^kube-apiserver-") || (resource["k8s.container.name"] == "kube-controller-manager" && resource["k8s.pod.name"] matches "^kube-controller-manager-") || (resource["k8s.container.name"] == "kube-scheduler" && resource["k8s.pod.name"] matches "^kube-scheduler-") || (resource["k8s.container.name"] == "etcd" && resource["k8s.pod.name"] matches "^etcd-"))
                type: add
                value: k8s.control_plane
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            start_at: end
          filelog/host-audit:
            include:
              - /hostfs/var/log/audit/audit.log
            include_file_path: true
            resource:
              nvidia.telemetry.class: system.audit
              service.name: auditd
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            start_at: end
          filelog/host-auth:
            include:
              - /hostfs/var/log/auth.log
              - /hostfs/var/log/secure
            include_file_path: true
            resource:
              nvidia.telemetry.class: system.auth
              service.name: auth
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            start_at: end
          filelog/kube-api-audit:
            include:
              - /hostfs/var/log/kubernetes/audit/audit.log
            include_file_path: true
            resource:
              nvidia.telemetry.class: k8s.api.audit
              service.name: kube-apiserver
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            start_at: end
          filelog/operator:
            include:
              - /var/log/pods/${env:POD_NAMESPACE}_nktp-operator-*_*/manager/*.log
            include_file_path: true
            operators:
              - type: container
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            start_at: beginning
          filelog/targetallocator:
            include:
              - /var/log/pods/${env:POD_NAMESPACE}_nktp-*-targetallocator-*_*/ta-container/*.log
            include_file_path: true
            operators:
              - type: container
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            start_at: beginning
          journald:
            directory: /var/log/journal
            journalctl_path: /usr/bin/journalctl
            operators:
              - field: resource["service.name"]
                id: identify-journal-producer
                type: add
                value: journald
              - field: resource["nvidia.telemetry.class"]
                id: classify-host-auth
                if: body.SYSLOG_IDENTIFIER == "sshd" || body.SYSLOG_IDENTIFIER == "sudo"
                type: add
                value: system.auth
            priority: info
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            root_path: /hostfs
            start_at: end
          otlp:
            protocols:
              grpc:
                endpoint: 0.0.0.0:4317
              http:
                endpoint: 0.0.0.0:4318
          prometheus:
            config:
              scrape_configs: []
          prometheus/kubelet:
            config:
              scrape_configs:
                - authorization:
                    credentials_file: /var/run/secrets/kubernetes.io/serviceaccount/token
                    type: Bearer
                  job_name: kubelet
                  metrics_path: /metrics
                  relabel_configs:
                    - regex: (.+:.*)
                      replacement: '[$$1]:10250'
                      source_labels:
                        - __tmp_kubelet_host
                      target_label: __address__
                    - regex: ([^:]+)
                      replacement: $$1:10250
                      source_labels:
                        - __tmp_kubelet_host
                      target_label: __address__
                    - replacement: ${env:NODE_NAME}
                      target_label: node
                    - replacement: https-metrics
                      target_label: endpoint
                    - replacement: /metrics
                      target_label: metrics_path
                  scheme: https
                  scrape_interval: 30s
                  scrape_timeout: 10s
                  static_configs:
                    - labels:
                        __tmp_kubelet_host: ${env:OTEL_K8S_NODE_IP}
                      targets:
                        - 127.0.0.1:10250
                  tls_config:
                    insecure_skip_verify: true
                - authorization:
                    credentials_file: /var/run/secrets/kubernetes.io/serviceaccount/token
                    type: Bearer
                  job_name: kubelet-cadvisor
                  metric_relabel_configs:
                    - action: drop
                      regex: container_cpu_(cfs_throttled_seconds_total|load_average_10s|system_seconds_total|user_seconds_total)
                      source_labels:
                        - __name__
                    - action: drop
                      regex: container_fs_(io_current|io_time_seconds_total|io_time_weighted_seconds_total|reads_merged_total|sector_reads_total|sector_writes_total|writes_merged_total)
                      source_labels:
                        - __name__
                    - action: drop
                      regex: container_memory_(mapped_file|swap)
                      source_labels:
                        - __name__
                    - action: drop
                      regex: container_(file_descriptors|tasks_state|threads_max)
                      source_labels:
                        - __name__
                    - action: drop
                      regex: container_memory_failures_total;hierarchy
                      source_labels:
                        - __name__
                        - scope
                    - action: drop
                      regex: container_network_.*;(cali|cilium|cni|lxc|nodelocaldns|tunl).*
                      source_labels:
                        - __name__
                        - interface
                    - action: drop
                      regex: container_spec.*
                      source_labels:
                        - __name__
                    - action: drop
                      regex: .+;
                      source_labels:
                        - id
                        - pod
                  metrics_path: /metrics/cadvisor
                  relabel_configs:
                    - regex: (.+:.*)
                      replacement: '[$$1]:10250'
                      source_labels:
                        - __tmp_kubelet_host
                      target_label: __address__
                    - regex: ([^:]+)
                      replacement: $$1:10250
                      source_labels:
                        - __tmp_kubelet_host
                      target_label: __address__
                    - replacement: ${env:NODE_NAME}
                      target_label: node
                    - replacement: https-metrics
                      target_label: endpoint
                    - replacement: /metrics/cadvisor
                      target_label: metrics_path
                  scheme: https
                  scrape_interval: 30s
                  scrape_timeout: 10s
                  static_configs:
                    - labels:
                        __tmp_kubelet_host: ${env:OTEL_K8S_NODE_IP}
                      targets:
                        - 127.0.0.1:10250
                  tls_config:
                    insecure_skip_verify: true
        service:
          extensions:
            - health_check
          pipelines:
            logs:
              exporters:
                - otlp/logs
              processors:
                - memory_limiter
                - resource/node
                - redaction/basic_v1
              receivers:
                - filelog
                - journald
                - otlp
                - filelog/host-auth
                - filelog/host-audit
                - filelog/kube-api-audit
            logs/operator:
              exporters:
                - otlp/watchdog
              processors:
                - memory_limiter
                - resource/node
                - transform/operator
                - redaction/basic_v1
              receivers:
                - filelog/operator
            logs/targetallocator:
              exporters:
                - otlp/watchdog
              processors:
                - memory_limiter
                - resource/node
                - transform/targetallocator
                - redaction/basic_v1
              receivers:
                - filelog/targetallocator
            metrics:
              exporters:
                - otlp/metrics
              processors:
                - memory_limiter
                - resource/node
                - redaction/basic_v1
              receivers:
                - prometheus
                - prometheus/kubelet
                - otlp
            traces:
              exporters:
                - otlp/traces
              processors:
                - memory_limiter
                - resource/node
                - redaction/basic_v1
              receivers:
                - otlp
          telemetry:
            logs:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://127.0.0.1:4319
                        protocol: http/protobuf
            metrics:
              readers:
                - periodic:
                    exporter:
                      otlp:
                        endpoint: http://127.0.0.1:4319
                        protocol: http/protobuf
            resource:
              k8s.node.name: ${env:NODE_NAME}
              service.instance.id: ${env:POD_NAME}
              service.name: nktp-daemonset
            traces:
              level: basic
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://127.0.0.1:4319
                        protocol: http/protobuf
                    schedule_delay: 1000
      env:
        - name: GOMEMLIMIT
          value: 768MiB
        - name: GOGC
          value: "50"
        - name: NODE_NAME
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: OTEL_K8S_NODE_IP
          valueFrom:
            fieldRef:
              fieldPath: status.hostIP
      image: otel/opentelemetry-collector-k8s:0.162.0
      initContainers:
        - args:
            - --config=yaml:{"exporters":{"otlp":{"endpoint":"nktp-watchdog-collector:4317","retry_on_failure":{"max_elapsed_time":"30m"},"sending_queue":{"batch":{"flush_timeout":"1s","max_size":262144,"min_size":65536,"sizer":"bytes"},"block_on_overflow":false,"num_consumers":2,"queue_size":4194304,"sizer":"bytes"},"tls":{"ca_file":"/etc/nktp/internal-tls/client/ca.crt","cert_file":"/etc/nktp/internal-tls/client/tls.crt","key_file":"/etc/nktp/internal-tls/client/tls.key","reload_interval":"1h"}}},"extensions":{"health_check":{"endpoint":"0.0.0.0:13134"}},"processors":{"memory_limiter":{"check_interval":"500ms","limit_percentage":80,"spike_limit_percentage":25},"tail_sampling":{"decision_cache":{"sampled_cache_size":10000},"decision_wait":"5s","num_traces":1000,"policies":[{"name":"errors","status_code":{"status_codes":["ERROR"]},"type":"status_code"},{"name":"slow","ottl_condition":{"error_mode":"ignore","span":["end_time_unix_nano - start_time_unix_nano \u003e 1000000000"]},"type":"ottl_condition"}]}},"receivers":{"otlp":{"protocols":{"http":{"endpoint":"127.0.0.1:4319","keepalive":{"idle_timeout":"5m"}}}}},"service":{"extensions":["health_check"],"pipelines":{"logs":{"exporters":["otlp"],"processors":["memory_limiter"],"receivers":["otlp"]},"metrics":{"exporters":["otlp"],"processors":["memory_limiter"],"receivers":["otlp"]},"traces":{"exporters":["otlp"],"processors":["memory_limiter","tail_sampling"],"receivers":["otlp"]}},"telemetry":{"logs":{"processors":[{"batch":{"exporter":{"otlp":{"endpoint":"http://127.0.0.1:4319","protocol":"http/protobuf"}}}}]},"metrics":{"readers":[{"periodic":{"exporter":{"otlp":{"endpoint":"http://127.0.0.1:4319","protocol":"http/protobuf"}}}}]},"resource":{"k8s.node.name":"${env:NODE_NAME}","service.instance.id":"${env:POD_NAME}","service.name":"nktp-daemonset-sidecar"},"traces":{"level":"none"}}}}
          env:
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: GOMEMLIMIT
              value: 96MiB
          image: otel/opentelemetry-collector-k8s:0.162.0
          livenessProbe:
            httpGet:
              path: /
              port: 13134
          name: otc-sidecar
          resources:
            limits:
              cpu: 100m
              memory: 128Mi
            requests:
              cpu: 10m
              memory: 32Mi
          restartPolicy: Always
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: true
            runAsNonRoot: true
          startupProbe:
            failureThreshold: 30
            httpGet:
              path: /
              port: 13134
            periodSeconds: 1
          volumeMounts:
            - mountPath: /etc/nktp/internal-tls/client
              name: internal-tls-client
              readOnly: true
      managementState: managed
      mode: daemonset
      podSecurityContext:
        seccompProfile:
          type: RuntimeDefault
      priorityClassName: nktp-telemetry-critical
      resources:
        limits:
          cpu: "2"
          memory: 2Gi
        requests:
          cpu: 500m
          memory: 1Gi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          add:
            - SYS_CHROOT
          drop:
            - ALL
        readOnlyRootFilesystem: true
        runAsUser: 0
      targetAllocator:
        allocationStrategy: per-node
        enabled: true
        env:
          - name: OTEL_SERVICE_NAME
            value: nktp-targetallocator
          - name: POD_NAME
            valueFrom:
              fieldRef:
                fieldPath: metadata.name
          - name: OTEL_RESOURCE_ATTRIBUTES
            value: service.instance.id=$(POD_NAME)
        image: ghcr.io/open-telemetry/opentelemetry-operator/target-allocator:0.161.0
        mtls:
          enabled: true
          useCertManager: true
        observability:
          metrics:
            enableMetrics: false
        prometheusCR:
          denyFSAccessThroughSMs: false
          enabled: true
          podMonitorSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: NotIn
                values:
                  - "true"
          probeSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: NotIn
                values:
                  - "true"
          scrapeConfigSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: NotIn
                values:
                  - "true"
          serviceMonitorSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: NotIn
                values:
                  - "true"
              - key: app
                operator: NotIn
                values:
                  - kube-prometheus-stack-kubelet
                  - prometheus-operator-kubelet
        replicas: 1
        resources:
          limits:
            cpu: "2"
            memory: 4Gi
          requests:
            cpu: 250m
            memory: 2Gi
        telemetry:
          metrics:
            readers:
              - periodic:
                  exporter:
                    otlpGrpc:
                      endpoint: nktp-watchdog-collector:4320
                      temporalityPreference: cumulative
                      tls:
                        insecure: true
                  interval: 30s
      terminationGracePeriodSeconds: 60
      tolerations:
        - operator: Exists
      upgradeStrategy: automatic
      volumeMounts:
        - mountPath: /var/log/pods
          name: pod-logs
          readOnly: true
        - mountPath: /hostfs/proc
          name: host-proc
          readOnly: true
        - mountPath: /hostfs/usr/bin/journalctl
          name: journalctl
          readOnly: true
        - mountPath: /hostfs/lib
          name: host-lib
          readOnly: true
        - mountPath: /hostfs/lib64
          name: host-lib64
          readOnly: true
        - mountPath: /hostfs/usr/lib64
          name: host-lib64
          readOnly: true
        - mountPath: /hostfs/usr/lib
          name: host-usr-lib
          readOnly: true
        - mountPath: /hostfs/etc/machine-id
          name: host-machine-id
          readOnly: true
        - mountPath: /hostfs/var/log
          name: host-logs
          readOnly: true
        - mountPath: /etc/nktp/internal-tls/client
          name: internal-tls-client
          readOnly: true
