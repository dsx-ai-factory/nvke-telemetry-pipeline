  71: |
    apiVersion: opentelemetry.io/v1beta1
    kind: OpenTelemetryCollector
    metadata:
      labels:
        helm.sh/chart: opentelemetry-kube-stack-0.25.1
      name: nktp-large-target-metrics
      namespace: NAMESPACE
    spec:
      autoscaler:
        behavior:
          scaleUp:
            policies:
              - periodSeconds: 15
                type: Percent
                value: 200
              - periodSeconds: 15
                type: Pods
                value: 8
            selectPolicy: Max
            stabilizationWindowSeconds: 0
        maxReplicas: 32
        minReplicas: 2
        targetCPUUtilization: 75
        targetMemoryUtilization: 100
      config:
        exporters:
          otlp:
            endpoint: nktp-gateway-metrics-collector:4317
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              block_on_overflow: true
              num_consumers: 32
              queue_size: 134217728
              sizer: bytes
            tls:
              ca_file: /etc/nktp/internal-tls/client/ca.crt
              cert_file: /etc/nktp/internal-tls/client/tls.crt
              key_file: /etc/nktp/internal-tls/client/tls.key
              reload_interval: 1h
        extensions:
          health_check:
            endpoint: 0.0.0.0:13133
        processors:
          batch:
            send_batch_max_size: 8192
            send_batch_size: 8192
            timeout: 0s
          memory_limiter:
            check_interval: 500ms
            limit_percentage: 80
            spike_limit_percentage: 15
          redaction/basic_v1:
            allow_all_keys: true
            blocked_key_patterns:
              - (?i)(?:(?:^|[._-])(?:password|passwd|secret|token|(?:access|refresh|id|session|auth)[._-]?token|(?:access|secret|private|api)[._-]?key|secret[._-]?access[._-]?key|client[._-]?secret|authorization|(?:set[._-]?)?cookie)|(?-i:[a-z0-9])(?:(?-i:P)(?:assword|asswd|rivate[._-]?key)|(?-i:S)ecret|(?-i:T)oken|(?-i:A)(?:pi[._-]?key|ccess[._-]?key|uthorization)|(?-i:C)ookie))$$
            blocked_values:
              - (?i)\bBearer\s+[A-Za-z0-9._~+/-]+=*
              - (?i)"?\b(?:[A-Za-z0-9]+[._-])*(?:password|passwd|secret|token|(?:access|refresh|id|session|auth)[._-]?token|(?:access|secret|private|api)[._-]?key|secret[._-]?access[._-]?key|client[._-]?secret|authorization|(?:set[._-]?)?cookie|[A-Za-z0-9]*(?-i:[a-z0-9])(?:(?-i:P)(?:assword|asswd|rivate[._-]?key)|(?-i:S)ecret|(?-i:T)oken|(?-i:A)(?:pi[._-]?key|ccess[._-]?key|uthorization)|(?-i:C)ookie))"?\s*[:=]\s*(?:"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|(?:(?:Bearer|Basic)\s+)?[^\s,;"]+)
            redact_all_types: true
            summary: silent
        receivers:
          prometheus:
            config:
              global:
                body_size_limit: 1GiB
                external_labels:
                  nktp_metrics_pool: large-target
                label_limit: 64
                label_name_length_limit: 256
                label_value_length_limit: 4096
                sample_limit: 1000000
              scrape_configs: []
        service:
          extensions:
            - health_check
          pipelines:
            metrics:
              exporters:
                - otlp
              processors:
                - memory_limiter
                - redaction/basic_v1
                - batch
              receivers:
                - prometheus
          telemetry:
            logs:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://127.0.0.1:4319
                        protocol: http/protobuf
            metrics:
              readers:
                - periodic:
                    exporter:
                      otlp:
                        endpoint: http://127.0.0.1:4319
                        protocol: http/protobuf
            resource:
              service.instance.id: ${env:POD_NAME}
              service.name: nktp-large-target-metrics
            traces:
              level: basic
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://127.0.0.1:4319
                        protocol: http/protobuf
                    schedule_delay: 1000
      env:
        - name: GOMEMLIMIT
          value: 7168MiB
        - name: GOGC
          value: "50"
      image: otel/opentelemetry-collector-k8s:0.162.0
      initContainers:
        - args:
            - --config=yaml:{"exporters":{"otlp":{"endpoint":"nktp-watchdog-collector:4317","retry_on_failure":{"max_elapsed_time":"30m"},"sending_queue":{"batch":{"flush_timeout":"1s","max_size":262144,"min_size":65536,"sizer":"bytes"},"block_on_overflow":false,"num_consumers":2,"queue_size":4194304,"sizer":"bytes"},"tls":{"ca_file":"/etc/nktp/internal-tls/client/ca.crt","cert_file":"/etc/nktp/internal-tls/client/tls.crt","key_file":"/etc/nktp/internal-tls/client/tls.key","reload_interval":"1h"}}},"extensions":{"health_check":{"endpoint":"0.0.0.0:13134"}},"processors":{"memory_limiter":{"check_interval":"500ms","limit_percentage":80,"spike_limit_percentage":25},"tail_sampling":{"decision_cache":{"sampled_cache_size":10000},"decision_wait":"5s","num_traces":1000,"policies":[{"name":"errors","status_code":{"status_codes":["ERROR"]},"type":"status_code"},{"name":"slow","ottl_condition":{"error_mode":"ignore","span":["end_time_unix_nano - start_time_unix_nano \u003e 1000000000"]},"type":"ottl_condition"}]}},"receivers":{"otlp":{"protocols":{"http":{"endpoint":"127.0.0.1:4319","keepalive":{"idle_timeout":"5m"}}}}},"service":{"extensions":["health_check"],"pipelines":{"logs":{"exporters":["otlp"],"processors":["memory_limiter"],"receivers":["otlp"]},"metrics":{"exporters":["otlp"],"processors":["memory_limiter"],"receivers":["otlp"]},"traces":{"exporters":["otlp"],"processors":["memory_limiter","tail_sampling"],"receivers":["otlp"]}},"telemetry":{"logs":{"processors":[{"batch":{"exporter":{"otlp":{"endpoint":"http://127.0.0.1:4319","protocol":"http/protobuf"}}}}]},"metrics":{"readers":[{"periodic":{"exporter":{"otlp":{"endpoint":"http://127.0.0.1:4319","protocol":"http/protobuf"}}}}]},"resource":{"service.instance.id":"${env:POD_NAME}","service.name":"nktp-large-target-metrics-sidecar"},"traces":{"level":"none"}}}}
          env:
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: GOMEMLIMIT
              value: 96MiB
          image: otel/opentelemetry-collector-k8s:0.162.0
          livenessProbe:
            httpGet:
              path: /
              port: 13134
          name: otc-sidecar
          resources:
            limits:
              cpu: 100m
              memory: 128Mi
            requests:
              cpu: 10m
              memory: 32Mi
          restartPolicy: Always
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: true
            runAsNonRoot: true
          startupProbe:
            failureThreshold: 30
            httpGet:
              path: /
              port: 13134
            periodSeconds: 1
          volumeMounts:
            - mountPath: /etc/nktp/internal-tls/client
              name: internal-tls-client
              readOnly: true
      managementState: managed
      mode: statefulset
      podDisruptionBudget:
        maxUnavailable: 25%
      podSecurityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      priorityClassName: nktp-telemetry-critical
      replicas: 2
      resources:
        limits:
          cpu: "4"
          memory: 12Gi
        requests:
          cpu: 500m
          memory: 2Gi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
        readOnlyRootFilesystem: true
      targetAllocator:
        allocationStrategy: consistent-hashing
        collectorTargetReloadInterval: 10s
        enabled: true
        env:
          - name: OTEL_SERVICE_NAME
            value: nktp-large-target-metrics-targetallocator
          - name: POD_NAME
            valueFrom:
              fieldRef:
                fieldPath: metadata.name
          - name: OTEL_RESOURCE_ATTRIBUTES
            value: service.instance.id=$(POD_NAME)
        image: ghcr.io/open-telemetry/opentelemetry-operator/target-allocator:0.161.0
        mtls:
          enabled: true
          useCertManager: true
        observability:
          metrics:
            enableMetrics: false
        podSecurityContext:
          runAsNonRoot: true
          seccompProfile:
            type: RuntimeDefault
        prometheusCR:
          denyFSAccessThroughSMs: false
          enabled: true
          podMonitorSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: In
                values:
                  - "true"
          probeSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: In
                values:
                  - "true"
          scrapeConfigSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: In
                values:
                  - "true"
          serviceMonitorSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: In
                values:
                  - "true"
        replicas: 1
        resources:
          limits:
            cpu: "1"
            memory: 2Gi
          requests:
            cpu: 250m
            memory: 1Gi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
              - ALL
          readOnlyRootFilesystem: true
        telemetry:
          metrics:
            readers:
              - periodic:
                  exporter:
                    otlpGrpc:
                      endpoint: nktp-watchdog-collector:4320
                      temporalityPreference: cumulative
                      tls:
                        insecure: true
                  interval: 30s
      terminationGracePeriodSeconds: 60
      topologySpreadConstraints:
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-large-target-metrics-collector
          maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-large-target-metrics-collector
          maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
      upgradeStrategy: automatic
      volumeMounts:
        - mountPath: /etc/nktp/internal-tls/client
          name: internal-tls-client
          readOnly: true
      volumes:
        - name: internal-tls-client
          secret:
            items:
              - key: tls.crt
                path: tls.crt
              - key: tls.key
                path: tls.key
              - key: ca.crt
                path: ca.crt
            secretName: nktp-large-target-metrics-client-tls
  72: |
    apiVersion: v1
    data:
      nktp.yaml: |
        apiVersion: 1
        providers:
          - name: nktp
            type: file
            options:
              path: /otel-lgtm/dashboards-nktp
              foldersFromFilesStructure: false
      wipe-defaults.yaml: |
        apiVersion: 1
        providers: []
    kind: ConfigMap
    metadata:
      name: lgtm-dashboard-provider
      namespace: NAMESPACE
  73: |
    apiVersion: v1
    data:
      nktp-cluster-events.json: |
        {
          "uid": "nktp-cluster-events",
          "title": "NKTP Cluster Events",
          "tags": [
            "nktp",
            "nktp-collector",
            "opentelemetry"
          ],
          "schemaVersion": 39,
          "refresh": "30s",
          "time": {
            "from": "now-30m",
            "to": "now"
          },
          "links": [
            {
              "title": "Collectors",
              "type": "dashboards",
              "tags": [
                "nktp-collector"
              ],
              "asDropdown": true,
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            },
            {
              "title": "NKTP Health",
              "type": "link",
              "url": "/d/nktp-health",
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            }
          ],
          "templating": {
            "list": []
          },
          "panels": [
            {
              "id": 1,
              "type": "row",
              "title": "Pipeline",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 2,
              "type": "timeseries",
              "title": "Received /s",
              "gridPos": {
                "x": 0,
                "y": 1,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-cluster-events\"}[5m]))",
                  "legendFormat": "log records",
                  "refId": "A"
                }
              ],
              "description": "Items received per second across all replicas."
            },
            {
              "id": 3,
              "type": "timeseries",
              "title": "Exported /s",
              "gridPos": {
                "x": 12,
                "y": 1,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_sent_log_records_total{job=\"nktp-cluster-events\"}[5m]))",
                  "legendFormat": "log records",
                  "refId": "A"
                }
              ],
              "description": "Items exported per second across all replicas."
            },
            {
              "id": 4,
              "type": "timeseries",
              "title": "Export failures /s",
              "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-cluster-events\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-cluster-events\",data_type=\"logs\"})",
                  "legendFormat": "log records",
                  "refId": "A"
                }
              ],
              "description": "Items that failed to send, across all replicas. The exporter may retry them."
            },
            {
              "id": 5,
              "type": "timeseries",
              "title": "Refused /s",
              "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"nktp-cluster-events\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-cluster-events\"}[5m]))",
                  "legendFormat": "log records",
                  "refId": "A"
                }
              ],
              "description": "Items the receivers refused across all replicas, for example under memory pressure."
            },
            {
              "id": 20,
              "type": "timeseries",
              "title": "Received /s by replica · top 20",
              "description": "The 20 replicas that received the most at the end of the range, to show imbalance.",
              "gridPos": {
                "x": 0,
                "y": 15,
                "w": 24,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "(sum by (instance) (rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-cluster-events\"}[5m]))) and on (instance) topk(20, sum by (instance) (rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-cluster-events\"}[5m] @ end())))",
                  "legendFormat": "{{instance}} log records",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 6,
              "type": "row",
              "title": "Leader election",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 23,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 7,
              "type": "logs",
              "title": "Leadership changes",
              "description": "Receiver leadership transitions in the selected time range. The latest message is not a live Lease status check.",
              "gridPos": {
                "x": 0,
                "y": 24,
                "w": 24,
                "h": 8
              },
              "datasource": {
                "type": "loki",
                "uid": "loki"
              },
              "targets": [
                {
                  "expr": "{service_name=\"nktp-cluster-events\"} |~ \"Events Receiver started as leader|no longer leader, stopping\"",
                  "refId": "A"
                }
              ],
              "options": {
                "showTime": true,
                "showLabels": true,
                "wrapLogMessage": true,
                "sortOrder": "Descending",
                "enableLogDetails": true
              }
            },
            {
              "id": 8,
              "type": "row",
              "title": "Queues and resources",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 32,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 9,
              "type": "timeseries",
              "title": "Exporter queue use · top 20",
              "gridPos": {
                "x": 0,
                "y": 33,
                "w": 24,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "percent"
                }
              },
              "targets": [
                {
                  "expr": "100 * (max by (instance, exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-cluster-events\"} / otelcol_exporter_queue_capacity{job=\"nktp-cluster-events\"})) and on (instance, exporter, data_type) topk(20, max by (instance, exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-cluster-events\"} @ end() / otelcol_exporter_queue_capacity{job=\"nktp-cluster-events\"} @ end()))",
                  "legendFormat": "{{instance}} {{exporter}} {{data_type}}",
                  "refId": "A"
                }
              ],
              "description": "The 20 fullest exporter queues at the end of the range."
            },
            {
              "id": 10,
              "type": "timeseries",
              "title": "CPU cores · top 20",
              "gridPos": {
                "x": 0,
                "y": 40,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "(sum by (instance) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-cluster-events\"}[5m]))) and on (instance) topk(20, sum by (instance) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-cluster-events\"}[5m] @ end())))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 11,
              "type": "timeseries",
              "title": "Memory (RSS) · top 20",
              "gridPos": {
                "x": 12,
                "y": 40,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "(sum by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-cluster-events\"})) and on (instance) topk(20, sum by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-cluster-events\"} @ end()))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 12,
              "type": "timeseries",
              "title": "Reporting replicas",
              "gridPos": {
                "x": 0,
                "y": 47,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "count(count by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-cluster-events\"}))",
                  "legendFormat": "reporting",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 13,
              "type": "row",
              "title": "Self-telemetry sidecar",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 54,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 14,
              "type": "timeseries",
              "title": "Sidecar queue use",
              "description": "Fullest sidecar export queue of any Pod, per signal. The sidecar buffers this Collector's internal telemetry while the watchdog is unavailable.",
              "gridPos": {
                "x": 0,
                "y": 55,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "percent"
                }
              },
              "targets": [
                {
                  "expr": "100 * max by (data_type) (otelcol_exporter_queue_size{job=\"nktp-cluster-events-sidecar\"} / otelcol_exporter_queue_capacity{job=\"nktp-cluster-events-sidecar\"})",
                  "legendFormat": "{{data_type}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 15,
              "type": "timeseries",
              "title": "Sidecar export failures /s",
              "description": "Internal telemetry that the sidecar failed to send to the watchdog, per signal.",
              "gridPos": {
                "x": 12,
                "y": 55,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{job=\"nktp-cluster-events-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-cluster-events-sidecar\",data_type=\"metrics\"})",
                  "legendFormat": "metrics",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-cluster-events-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-cluster-events-sidecar\",data_type=\"logs\"})",
                  "legendFormat": "logs",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_spans_total{job=\"nktp-cluster-events-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-cluster-events-sidecar\",data_type=\"traces\"})",
                  "legendFormat": "traces",
                  "refId": "C"
                }
              ]
            },
            {
              "id": 16,
              "type": "timeseries",
              "title": "Sidecar refused /s",
              "description": "Internal telemetry that the sidecar refused, per signal, for example under memory pressure.",
              "gridPos": {
                "x": 0,
                "y": 62,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_refused_metric_points_total{job=\"nktp-cluster-events-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-cluster-events-sidecar\"}[5m]))",
                  "legendFormat": "metrics",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"nktp-cluster-events-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-cluster-events-sidecar\"}[5m]))",
                  "legendFormat": "logs",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_spans_total{job=\"nktp-cluster-events-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_spans_total{job=\"nktp-cluster-events-sidecar\"}[5m]))",
                  "legendFormat": "traces",
                  "refId": "C"
                }
              ]
            },
            {
              "id": 17,
              "type": "timeseries",
              "title": "Sidecar traces kept and dropped /s",
              "description": "Tail sampling decisions. A trace is kept when a span has an error or lasts longer than 1 second.",
              "gridPos": {
                "x": 12,
                "y": 62,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-cluster-events-sidecar\",sampled=\"true\"}[5m])) or 0 * sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-cluster-events-sidecar\",sampled=\"false\"}[5m]))",
                  "legendFormat": "kept",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-cluster-events-sidecar\",sampled=\"false\"}[5m]))",
                  "legendFormat": "dropped",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 18,
              "type": "timeseries",
              "title": "Sidecar CPU cores, highest Pod",
              "gridPos": {
                "x": 0,
                "y": 69,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "max(rate(otelcol_process_cpu_seconds_total{job=\"nktp-cluster-events-sidecar\"}[5m]))",
                  "legendFormat": "highest Pod",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 19,
              "type": "timeseries",
              "title": "Sidecar memory (RSS), highest Pod",
              "gridPos": {
                "x": 12,
                "y": 69,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "max(otelcol_process_memory_rss_bytes{job=\"nktp-cluster-events-sidecar\"})",
                  "legendFormat": "highest Pod",
                  "refId": "A"
                }
              ],
              "description": "Memory of the sidecar that uses the most. Compare it with the sidecar's memory limit."
            }
          ]
        }
      nktp-daemonset.json: |
        {
          "uid": "nktp-daemonset",
          "title": "NKTP DaemonSet",
          "tags": [
            "nktp",
            "nktp-collector",
            "opentelemetry"
          ],
          "schemaVersion": 39,
          "refresh": "30s",
          "time": {
            "from": "now-30m",
            "to": "now"
          },
          "links": [
            {
              "title": "Collectors",
              "type": "dashboards",
              "tags": [
                "nktp-collector"
              ],
              "asDropdown": true,
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            },
            {
              "title": "NKTP Health",
              "type": "link",
              "url": "/d/nktp-health",
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            }
          ],
          "templating": {
            "list": []
          },
          "panels": [
            {
              "id": 1,
              "type": "row",
              "title": "Pipeline",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 2,
              "type": "timeseries",
              "title": "Received /s",
              "gridPos": {
                "x": 0,
                "y": 1,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "metric points",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "log records",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_accepted_spans_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "spans",
                  "refId": "C"
                }
              ],
              "description": "Items received per second across all replicas."
            },
            {
              "id": 3,
              "type": "timeseries",
              "title": "Exported /s",
              "gridPos": {
                "x": 12,
                "y": 1,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_sent_metric_points_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "metric points",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_sent_log_records_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "log records",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_sent_spans_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "spans",
                  "refId": "C"
                }
              ],
              "description": "Items exported per second across all replicas."
            },
            {
              "id": 4,
              "type": "timeseries",
              "title": "Export failures /s",
              "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{job=\"nktp-daemonset\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-daemonset\",data_type=\"metrics\"})",
                  "legendFormat": "metric points",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-daemonset\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-daemonset\",data_type=\"logs\"})",
                  "legendFormat": "log records",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_spans_total{job=\"nktp-daemonset\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-daemonset\",data_type=\"traces\"})",
                  "legendFormat": "spans",
                  "refId": "C"
                }
              ],
              "description": "Items that failed to send, across all replicas. The exporter may retry them."
            },
            {
              "id": 5,
              "type": "timeseries",
              "title": "Refused /s",
              "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_refused_metric_points_total{job=\"nktp-daemonset\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "metric points",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"nktp-daemonset\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "log records",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_spans_total{job=\"nktp-daemonset\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_spans_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "spans",
                  "refId": "C"
                }
              ],
              "description": "Items the receivers refused across all replicas, for example under memory pressure."
            },
            {
              "id": 24,
              "type": "timeseries",
              "title": "Received /s by node · top 20",
              "description": "The 20 nodes that received the most at the end of the range, to show imbalance.",
              "gridPos": {
                "x": 0,
                "y": 15,
                "w": 24,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "(sum by (k8s_node_name) (rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-daemonset\"}[5m]))) and on (k8s_node_name) topk(20, sum by (k8s_node_name) (rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-daemonset\"}[5m] @ end())))",
                  "legendFormat": "{{k8s_node_name}} metric points",
                  "refId": "A"
                },
                {
                  "expr": "(sum by (k8s_node_name) (rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-daemonset\"}[5m]))) and on (k8s_node_name) topk(20, sum by (k8s_node_name) (rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-daemonset\"}[5m] @ end())))",
                  "legendFormat": "{{k8s_node_name}} log records",
                  "refId": "B"
                },
                {
                  "expr": "(sum by (k8s_node_name) (rate(otelcol_receiver_accepted_spans_total{job=\"nktp-daemonset\"}[5m]))) and on (k8s_node_name) topk(20, sum by (k8s_node_name) (rate(otelcol_receiver_accepted_spans_total{job=\"nktp-daemonset\"}[5m] @ end())))",
                  "legendFormat": "{{k8s_node_name}} spans",
                  "refId": "C"
                }
              ]
            },
            {
              "id": 6,
              "type": "row",
              "title": "Target Allocator",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 23,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 7,
              "type": "timeseries",
              "title": "Target Allocator collectors",
              "gridPos": {
                "x": 0,
                "y": 24,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "opentelemetry_allocator_collectors_discovered{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}} discovered",
                  "refId": "A"
                },
                {
                  "expr": "opentelemetry_allocator_collectors_allocatable{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}} allocatable",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 8,
              "type": "timeseries",
              "title": "Target Allocator targets",
              "gridPos": {
                "x": 12,
                "y": 24,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "opentelemetry_allocator_targets{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}} discovered",
                  "refId": "A"
                },
                {
                  "expr": "opentelemetry_allocator_targets_remaining{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}} after filtering",
                  "refId": "B"
                },
                {
                  "expr": "opentelemetry_allocator_targets_unassigned{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}} unassigned",
                  "refId": "C"
                }
              ],
              "description": "Counts per Target Allocator replica. Replicas can report the same target set, so these counts are not summed."
            },
            {
              "id": 9,
              "type": "timeseries",
              "title": "Targets per collector",
              "gridPos": {
                "x": 0,
                "y": 31,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "opentelemetry_allocator_targets_per_collector{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}} / {{collector_name}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 10,
              "type": "timeseries",
              "title": "Target Allocator CPU cores",
              "gridPos": {
                "x": 12,
                "y": 31,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "rate(process_cpu_seconds_total{job=\"nktp-targetallocator\"}[5m])",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 11,
              "type": "timeseries",
              "title": "Target Allocator memory (RSS)",
              "gridPos": {
                "x": 0,
                "y": 38,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "process_resident_memory_bytes{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 12,
              "type": "row",
              "title": "Queues and resources",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 45,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 13,
              "type": "timeseries",
              "title": "Exporter queue use · top 20",
              "gridPos": {
                "x": 0,
                "y": 46,
                "w": 24,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "percent"
                }
              },
              "targets": [
                {
                  "expr": "100 * (max by (k8s_node_name, exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-daemonset\"} / otelcol_exporter_queue_capacity{job=\"nktp-daemonset\"})) and on (k8s_node_name, exporter, data_type) topk(20, max by (k8s_node_name, exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-daemonset\"} @ end() / otelcol_exporter_queue_capacity{job=\"nktp-daemonset\"} @ end()))",
                  "legendFormat": "{{k8s_node_name}} {{exporter}} {{data_type}}",
                  "refId": "A"
                }
              ],
              "description": "The 20 fullest exporter queues at the end of the range."
            },
            {
              "id": 14,
              "type": "timeseries",
              "title": "CPU cores · top 20",
              "gridPos": {
                "x": 0,
                "y": 53,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "(sum by (k8s_node_name) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-daemonset\"}[5m]))) and on (k8s_node_name) topk(20, sum by (k8s_node_name) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-daemonset\"}[5m] @ end())))",
                  "legendFormat": "{{k8s_node_name}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 15,
              "type": "timeseries",
              "title": "Memory (RSS) · top 20",
              "gridPos": {
                "x": 12,
                "y": 53,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "(sum by (k8s_node_name) (otelcol_process_memory_rss_bytes{job=\"nktp-daemonset\"})) and on (k8s_node_name) topk(20, sum by (k8s_node_name) (otelcol_process_memory_rss_bytes{job=\"nktp-daemonset\"} @ end()))",
                  "legendFormat": "{{k8s_node_name}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 16,
              "type": "timeseries",
              "title": "Reporting replicas",
              "gridPos": {
                "x": 0,
                "y": 60,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "count(count by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-daemonset\"}))",
                  "legendFormat": "reporting",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 17,
              "type": "row",
              "title": "Self-telemetry sidecar",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 67,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 18,
              "type": "timeseries",
              "title": "Sidecar queue use",
              "description": "Fullest sidecar export queue of any Pod, per signal. The sidecar buffers this Collector's internal telemetry while the watchdog is unavailable.",
              "gridPos": {
                "x": 0,
                "y": 68,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "percent"
                }
              },
              "targets": [
                {
                  "expr": "100 * max by (data_type) (otelcol_exporter_queue_size{job=\"nktp-daemonset-sidecar\"} / otelcol_exporter_queue_capacity{job=\"nktp-daemonset-sidecar\"})",
                  "legendFormat": "{{data_type}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 19,
              "type": "timeseries",
              "title": "Sidecar export failures /s",
              "description": "Internal telemetry that the sidecar failed to send to the watchdog, per signal.",
              "gridPos": {
                "x": 12,
                "y": 68,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{job=\"nktp-daemonset-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-daemonset-sidecar\",data_type=\"metrics\"})",
                  "legendFormat": "metrics",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-daemonset-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-daemonset-sidecar\",data_type=\"logs\"})",
                  "legendFormat": "logs",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_spans_total{job=\"nktp-daemonset-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-daemonset-sidecar\",data_type=\"traces\"})",
                  "legendFormat": "traces",
                  "refId": "C"
                }
              ]
            },
            {
              "id": 20,
              "type": "timeseries",
              "title": "Sidecar refused /s",
              "description": "Internal telemetry that the sidecar refused, per signal, for example under memory pressure.",
              "gridPos": {
                "x": 0,
                "y": 75,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_refused_metric_points_total{job=\"nktp-daemonset-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-daemonset-sidecar\"}[5m]))",
                  "legendFormat": "metrics",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"nktp-daemonset-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-daemonset-sidecar\"}[5m]))",
                  "legendFormat": "logs",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_spans_total{job=\"nktp-daemonset-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_spans_total{job=\"nktp-daemonset-sidecar\"}[5m]))",
                  "legendFormat": "traces",
                  "refId": "C"
                }
              ]
            },
            {
              "id": 21,
              "type": "timeseries",
              "title": "Sidecar traces kept and dropped /s",
              "description": "Tail sampling decisions. A trace is kept when a span has an error or lasts longer than 1 second.",
              "gridPos": {
                "x": 12,
                "y": 75,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-daemonset-sidecar\",sampled=\"true\"}[5m])) or 0 * sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-daemonset-sidecar\",sampled=\"false\"}[5m]))",
                  "legendFormat": "kept",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-daemonset-sidecar\",sampled=\"false\"}[5m]))",
                  "legendFormat": "dropped",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 22,
              "type": "timeseries",
              "title": "Sidecar CPU cores, highest Pod",
              "gridPos": {
                "x": 0,
                "y": 82,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "max(rate(otelcol_process_cpu_seconds_total{job=\"nktp-daemonset-sidecar\"}[5m]))",
                  "legendFormat": "highest Pod",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 23,
              "type": "timeseries",
              "title": "Sidecar memory (RSS), highest Pod",
              "gridPos": {
                "x": 12,
                "y": 82,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "max(otelcol_process_memory_rss_bytes{job=\"nktp-daemonset-sidecar\"})",
                  "legendFormat": "highest Pod",
                  "refId": "A"
                }
              ],
              "description": "Memory of the sidecar that uses the most. Compare it with the sidecar's memory limit."
            }
          ]
        }
      nktp-gateway-logs.json: |
        {
          "uid": "nktp-gateway-logs",
          "title": "NKTP Logs Gateway",
          "tags": [
            "nktp",
            "nktp-collector",
            "opentelemetry"
          ],
          "schemaVersion": 39,
          "refresh": "30s",
          "time": {
            "from": "now-30m",
            "to": "now"
          },
          "links": [
            {
              "title": "Collectors",
              "type": "dashboards",
              "tags": [
                "nktp-collector"
              ],
              "asDropdown": true,
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            },
            {
              "title": "NKTP Health",
              "type": "link",
              "url": "/d/nktp-health",
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            }
          ],
          "templating": {
            "list": []
          },
          "panels": [
            {
              "id": 1,
              "type": "row",
              "title": "Pipeline",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 2,
              "type": "timeseries",
              "title": "Received /s",
              "gridPos": {
                "x": 0,
                "y": 1,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-gateway-logs\"}[5m]))",
                  "legendFormat": "log records",
                  "refId": "A"
                }
              ],
              "description": "Items received per second across all replicas."
            },
            {
              "id": 3,
              "type": "timeseries",
              "title": "Exported /s",
              "gridPos": {
                "x": 12,
                "y": 1,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_sent_log_records_total{job=\"nktp-gateway-logs\"}[5m]))",
                  "legendFormat": "log records",
                  "refId": "A"
                }
              ],
              "description": "Items exported per second across all replicas."
            },
            {
              "id": 4,
              "type": "timeseries",
              "title": "Export failures /s",
              "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-gateway-logs\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-gateway-logs\",data_type=\"logs\"})",
                  "legendFormat": "log records",
                  "refId": "A"
                }
              ],
              "description": "Items that failed to send, across all replicas. The exporter may retry them."
            },
            {
              "id": 5,
              "type": "timeseries",
              "title": "Refused /s",
              "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"nktp-gateway-logs\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-gateway-logs\"}[5m]))",
                  "legendFormat": "log records",
                  "refId": "A"
                }
              ],
              "description": "Items the receivers refused across all replicas, for example under memory pressure."
            },
            {
              "id": 17,
              "type": "timeseries",
              "title": "Received /s by replica · top 20",
