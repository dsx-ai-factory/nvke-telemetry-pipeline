                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ]
                    },
                    "overrides": [
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Target"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "string"
                          },
                          {
                            "id": "custom.width",
                            "value": 650
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Request"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "bytes"
                          },
                          {
                            "id": "custom.width",
                            "value": 170
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Limit"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "bytes"
                          },
                          {
                            "id": "custom.width",
                            "value": 170
                          }
                        ]
                      }
                    ]
                  },
                  "options": {
                    "showHeader": true,
                    "cellHeight": "sm",
                    "footer": {
                      "show": false
                    },
                    "sortBy": [
                      {
                        "displayName": "Request",
                        "desc": true
                      },
                      {
                        "displayName": "Limit",
                        "desc": true
                      },
                      {
                        "displayName": "Target",
                        "desc": false
                      }
                    ]
                  },
                  "transformations": [
                    {
                      "id": "joinByField",
                      "options": {
                        "byField": "target",
                        "mode": "outerTabular"
                      }
                    },
                    {
                      "id": "organize",
                      "options": {
                        "excludeByName": {
                          "Time": true,
                          "Time 1": true,
                          "Time 2": true,
                          "Value #A": true
                        },
                        "indexByName": {
                          "target": 0,
                          "Value #B": 1,
                          "Value #C": 2
                        },
                        "renameByName": {
                          "target": "Target",
                          "Value #B": "Request",
                          "Value #C": "Limit"
                        }
                      }
                    }
                  ]
                },
                {
                  "id": 12,
                  "type": "timeseries",
                  "title": "Collector process CPU \u00b7 top 20",
                  "description": "CPU consumed by the Collector process. This is separate from container CPU usage and includes no container request or limit comparison. Shows up to 20 replicas.",
                  "gridPos": {
                    "x": 0,
                    "y": 63,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(sum by (job, instance) (rate(otelcol_process_cpu_seconds_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval]))) and on (job, instance) topk(20, sum by (job, instance) (rate(otelcol_process_cpu_seconds_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval] @ end())))",
                      "legendFormat": "{{instance}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "cores",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 13,
                  "type": "timeseries",
                  "title": "Collector process RSS \u00b7 top 20",
                  "description": "Resident memory of each Collector process. RSS is not the memory limiter heap measurement. Shows up to 20 series with the highest value at the end of the selected range.",
                  "gridPos": {
                    "x": 12,
                    "y": 63,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(max by (job, instance) (otelcol_process_memory_rss_bytes{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"})) and on (job, instance) topk(20, max by (job, instance) (otelcol_process_memory_rss_bytes{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} @ end()))",
                      "legendFormat": "{{instance}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "bytes",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 15,
                  "type": "table",
                  "title": "Autoscaler conditions",
                  "description": "True Kubernetes HPA conditions. ScalingActive false or unknown means the HPA cannot currently calculate scaling. Check metrics-server and the HPA events. ScalingLimited can simply mean the configured replica limit was reached.",
                  "gridPos": {
                    "x": 0,
                    "y": 70,
                    "w": 24,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "max by (horizontalpodautoscaler, condition, status) (kube_horizontalpodautoscaler_status_condition{namespace=\"$namespace\",horizontalpodautoscaler=~\"nktp-.*\"} == 1)",
                      "legendFormat": "",
                      "refId": "A",
                      "range": false,
                      "instant": true,
                      "interval": "1m",
                      "format": "table"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ]
                    },
                    "overrides": []
                  },
                  "options": {
                    "showHeader": true,
                    "cellHeight": "sm",
                    "footer": {
                      "show": false
                    }
                  },
                  "transformations": [
                    {
                      "id": "organize",
                      "options": {
                        "excludeByName": {
                          "Time": true,
                          "Value": true
                        },
                        "renameByName": {
                          "horizontalpodautoscaler": "Autoscaler",
                          "condition": "Condition",
                          "status": "State"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": 22,
              "type": "row",
              "title": "Target allocation and scrape health",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 36,
                "w": 24,
                "h": 1
              },
              "panels": [
                {
                  "id": 17,
                  "type": "timeseries",
                  "title": "Allocator collector counts",
                  "description": "Counts observed by each Target Allocator replica. Discovered collectors can include collectors that are not yet allocatable. Replicas are kept separate.",
                  "gridPos": {
                    "x": 0,
                    "y": 37,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "opentelemetry_allocator_collectors_discovered{job=~\"nktp-(targetallocator|watchdog-targetallocator|large-target-metrics-targetallocator)\"}",
                      "legendFormat": "{{job}} \u00b7 {{instance}} discovered",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "opentelemetry_allocator_collectors_allocatable{job=~\"nktp-(targetallocator|watchdog-targetallocator|large-target-metrics-targetallocator)\"}",
                      "legendFormat": "{{job}} \u00b7 {{instance}} allocatable",
                      "refId": "B",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 18,
                  "type": "timeseries",
                  "title": "Largest target assignments \u00b7 top 20",
                  "description": "Target assignments reported by each allocator. Shows the 20 largest assignments at the end of the selected range, not target cost or scrape success. Allocator replicas are not summed.",
                  "gridPos": {
                    "x": 12,
                    "y": 37,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(opentelemetry_allocator_targets_per_collector{job=~\"nktp-(targetallocator|watchdog-targetallocator|large-target-metrics-targetallocator)\"}) and on (job, instance, collector_name) topk(20, opentelemetry_allocator_targets_per_collector{job=~\"nktp-(targetallocator|watchdog-targetallocator|large-target-metrics-targetallocator)\"} @ end())",
                      "legendFormat": "{{job}} \u00b7 {{collector_name}} \u00b7 {{instance}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 19,
                  "type": "table",
                  "title": "Failed and slow scrape targets",
                  "description": "Up to 20 failed endpoints and the 20 slowest endpoints, with current up value, scrape duration and samples. Zero in Up means a failed scrape. Missing rows can mean discovery or telemetry is unavailable. Sample counts measure target size, not unique series across the pipeline.",
                  "gridPos": {
                    "x": 0,
                    "y": 44,
                    "w": 24,
                    "h": 9
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "max by (target) (label_join((max by (job, instance) ((up{namespace=\"$namespace\",job=~\"$namespace/nktp-.*|nktp-operator|node-exporter\"} or up{job=\"kubelet\"} or up{job=\"otelcol-contrib\"}))) and on (job, instance) (topk(20, max by (job, instance) ((up{namespace=\"$namespace\",job=~\"$namespace/nktp-.*|nktp-operator|node-exporter\"} or up{job=\"kubelet\"} or up{job=\"otelcol-contrib\"})) == 0) or on (job, instance) topk(20, max by (job, instance) (scrape_duration_seconds and on (job, instance) (up{namespace=\"$namespace\",job=~\"$namespace/nktp-.*|nktp-operator|node-exporter\"} or up{job=\"kubelet\"} or up{job=\"otelcol-contrib\"})))), \"target\", \" \u00b7 \", \"job\", \"instance\"))",
                      "legendFormat": "",
                      "refId": "A",
                      "range": false,
                      "instant": true,
                      "interval": "1m",
                      "format": "table"
                    },
                    {
                      "expr": "max by (target) (label_join((max by (job, instance) (scrape_duration_seconds and on (job, instance) (up{namespace=\"$namespace\",job=~\"$namespace/nktp-.*|nktp-operator|node-exporter\"} or up{job=\"kubelet\"} or up{job=\"otelcol-contrib\"}))) and on (job, instance) (topk(20, max by (job, instance) ((up{namespace=\"$namespace\",job=~\"$namespace/nktp-.*|nktp-operator|node-exporter\"} or up{job=\"kubelet\"} or up{job=\"otelcol-contrib\"})) == 0) or on (job, instance) topk(20, max by (job, instance) (scrape_duration_seconds and on (job, instance) (up{namespace=\"$namespace\",job=~\"$namespace/nktp-.*|nktp-operator|node-exporter\"} or up{job=\"kubelet\"} or up{job=\"otelcol-contrib\"})))), \"target\", \" \u00b7 \", \"job\", \"instance\"))",
                      "legendFormat": "",
                      "refId": "B",
                      "range": false,
                      "instant": true,
                      "interval": "1m",
                      "format": "table"
                    },
                    {
                      "expr": "max by (target) (label_join((max by (job, instance) (scrape_samples_scraped and on (job, instance) (up{namespace=\"$namespace\",job=~\"$namespace/nktp-.*|nktp-operator|node-exporter\"} or up{job=\"kubelet\"} or up{job=\"otelcol-contrib\"}))) and on (job, instance) (topk(20, max by (job, instance) ((up{namespace=\"$namespace\",job=~\"$namespace/nktp-.*|nktp-operator|node-exporter\"} or up{job=\"kubelet\"} or up{job=\"otelcol-contrib\"})) == 0) or on (job, instance) topk(20, max by (job, instance) (scrape_duration_seconds and on (job, instance) (up{namespace=\"$namespace\",job=~\"$namespace/nktp-.*|nktp-operator|node-exporter\"} or up{job=\"kubelet\"} or up{job=\"otelcol-contrib\"})))), \"target\", \" \u00b7 \", \"job\", \"instance\"))",
                      "legendFormat": "",
                      "refId": "C",
                      "range": false,
                      "instant": true,
                      "interval": "1m",
                      "format": "table"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ]
                    },
                    "overrides": [
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Up"
                        },
                        "properties": [
                          {
                            "id": "mappings",
                            "value": [
                              {
                                "type": "value",
                                "options": {
                                  "0": {
                                    "text": "Down",
                                    "color": "red"
                                  },
                                  "1": {
                                    "text": "Up",
                                    "color": "green"
                                  }
                                }
                              }
                            ]
                          },
                          {
                            "id": "custom.cellOptions",
                            "value": {
                              "type": "color-text"
                            }
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Duration"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "s"
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Target"
                        },
                        "properties": [
                          {
                            "id": "custom.width",
                            "value": 700
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Up"
                        },
                        "properties": [
                          {
                            "id": "custom.width",
                            "value": 80
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Duration"
                        },
                        "properties": [
                          {
                            "id": "custom.width",
                            "value": 150
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Samples"
                        },
                        "properties": [
                          {
                            "id": "custom.width",
                            "value": 150
                          }
                        ]
                      }
                    ]
                  },
                  "options": {
                    "showHeader": true,
                    "cellHeight": "sm",
                    "footer": {
                      "show": false
                    },
                    "sortBy": [
                      {
                        "displayName": "Up",
                        "desc": false
                      },
                      {
                        "displayName": "Duration",
                        "desc": true
                      }
                    ]
                  },
                  "transformations": [
                    {
                      "id": "joinByField",
                      "options": {
                        "byField": "target",
                        "mode": "outerTabular"
                      }
                    },
                    {
                      "id": "organize",
                      "options": {
                        "excludeByName": {
                          "Time": true,
                          "Time 1": true,
                          "Time 2": true,
                          "job 1": true,
                          "job 2": true
                        },
                        "renameByName": {
                          "target": "Target",
                          "Value #A": "Up",
                          "Value #B": "Duration",
                          "Value #C": "Samples"
                        }
                      }
                    }
                  ]
                },
                {
                  "id": 20,
                  "type": "timeseries",
                  "title": "Allocator process CPU",
                  "description": "",
                  "gridPos": {
                    "x": 0,
                    "y": 53,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
