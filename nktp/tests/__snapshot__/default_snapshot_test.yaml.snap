              cert_file: /etc/nktp/internal-tls/client/tls.crt
              key_file: /etc/nktp/internal-tls/client/tls.key
              reload_interval: 1h
          otlp/watchdog:
            endpoint: nktp-watchdog-collector:4317
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
