                    }
                  }
                }
              ]
            },
            {
              "id": 37,
              "type": "row",
              "title": "Investigate logs and internal traces",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 40,
                "w": 24,
                "h": 1
              },
              "panels": [
                {
                  "id": 35,
                  "type": "logs",
                  "title": "NKTP diagnostic logs",
                  "description": "Collector native logs and Target Allocator and Operator container logs delivered through watchdog. Pod identity is service_instance_id. Search is a case-insensitive text match and does not infer severity. Early plain-text startup errors remain searchable.",
                  "gridPos": {
                    "x": 0,
                    "y": 41,
                    "w": 24,
                    "h": 12
                  },
                  "datasource": {
                    "type": "loki",
                    "uid": "${logs}"
                  },
                  "targets": [
                    {
                      "refId": "A",
                      "expr": "{service_name=~\"$service\"} | label_format __nktp_search_match=`{{ contains (lower (urldecode \"${search:percentencode}\")) (lower (__line__)) }}` | __nktp_search_match=\"true\" | drop __nktp_search_match",
                      "queryType": "range",
                      "maxLines": 200
                    }
                  ],
                  "options": {
                    "showTime": true,
                    "showLabels": false,
                    "showCommonLabels": false,
                    "wrapLogMessage": false,
                    "prettifyLogMessage": false,
                    "enableLogDetails": true,
                    "sortOrder": "Descending",
                    "dedupStrategy": "none"
                  }
                },
                {
                  "id": 36,
                  "type": "table",
                  "title": "Collector internal traces",
                  "description": "Recent traces that contain a span from an NKTP Collector service. Collector instrumentation records its own receiver, processor and exporter work. Target Allocators and Operator do not emit native traces in the bundled version. Open a trace to inspect errors and latency.",
                  "gridPos": {
                    "x": 0,
                    "y": 53,
                    "w": 24,
                    "h": 9
                  },
                  "datasource": {
                    "type": "tempo",
                    "uid": "${traces}"
                  },
                  "targets": [
                    {
                      "refId": "A",
                      "queryType": "traceql",
                      "query": "{ resource.service.name =~ \"$service\" }",
                      "limit": 20,
                      "tableType": "traces"
                    }
                  ],
                  "options": {
                    "showHeader": true,
                    "cellHeight": "sm"
                  },
                  "fieldConfig": {
                    "defaults": {},
                    "overrides": []
                  }
                }
              ]
            },
            {
              "id": 62,
              "type": "row",
              "title": "Self-telemetry sidecars",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 41,
                "w": 24,
                "h": 1
              },
              "panels": [
                {
                  "id": 55,
                  "type": "timeseries",
                  "title": "Sidecar refused input",
                  "description": "Self-telemetry sidecars only. Items rejected per second, separated by component and signal. The sender may retry. This is not a permanent-loss count. Zero means no reported failures where matching telemetry is present. Missing telemetry stays unknown.",
                  "gridPos": {
                    "x": 0,
                    "y": 42,
                    "w": 8,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(sum by (job) (rate(otelcol_receiver_refused_metric_points_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval])) or 0 * sum by (job) (rate(otelcol_receiver_accepted_metric_points_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval])))",
                      "legendFormat": "{{job}} metrics",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "(sum by (job) (rate(otelcol_receiver_refused_log_records_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval])) or 0 * sum by (job) (rate(otelcol_receiver_accepted_log_records_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval])))",
                      "legendFormat": "{{job}} logs",
                      "refId": "B",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "(sum by (job) (rate(otelcol_receiver_refused_spans_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval])) or 0 * sum by (job) (rate(otelcol_receiver_accepted_spans_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval])))",
                      "legendFormat": "{{job}} traces",
                      "refId": "C",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "suffix:items/s",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 56,
                  "type": "timeseries",
                  "title": "Sidecar failed sends",
                  "description": "Self-telemetry sidecars only. Items per second that exporters failed to send to their destination, separated by component and signal. The exporter may retry them. This is not a permanent-loss count. Zero is anchored to a present exporter queue. Missing telemetry stays unknown.",
                  "gridPos": {
                    "x": 8,
                    "y": 42,
                    "w": 8,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "sum by (job) ((sum by (job, instance, exporter) (rate(otelcol_exporter_send_failed_metric_points_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval])) or (0 * max by (job, instance, exporter) (otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\",data_type=\"metrics\"}))))",
                      "legendFormat": "{{job}} metrics",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "sum by (job) ((sum by (job, instance, exporter) (rate(otelcol_exporter_send_failed_log_records_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval])) or (0 * max by (job, instance, exporter) (otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\",data_type=\"logs\"}))))",
                      "legendFormat": "{{job}} logs",
                      "refId": "B",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "sum by (job) ((sum by (job, instance, exporter) (rate(otelcol_exporter_send_failed_spans_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval])) or (0 * max by (job, instance, exporter) (otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\",data_type=\"traces\"}))))",
                      "legendFormat": "{{job}} traces",
                      "refId": "C",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "suffix:items/s",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 57,
                  "type": "timeseries",
                  "title": "Sidecar enqueue failures",
                  "description": "Self-telemetry sidecars only. Items per second that exporters could not add to a full sending queue, separated by component and signal. The error returns to the receiver, so a pushing sender may retry. This is not a permanent-loss count. Zero is anchored to a present exporter queue. Missing telemetry stays unknown.",
                  "gridPos": {
                    "x": 16,
                    "y": 42,
                    "w": 8,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "sum by (job) ((sum by (job, instance, exporter) (rate(otelcol_exporter_enqueue_failed_metric_points_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval])) or (0 * max by (job, instance, exporter) (otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\",data_type=\"metrics\"}))))",
                      "legendFormat": "{{job}} metrics",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "sum by (job) ((sum by (job, instance, exporter) (rate(otelcol_exporter_enqueue_failed_log_records_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval])) or (0 * max by (job, instance, exporter) (otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\",data_type=\"logs\"}))))",
                      "legendFormat": "{{job}} logs",
                      "refId": "B",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "sum by (job) ((sum by (job, instance, exporter) (rate(otelcol_exporter_enqueue_failed_spans_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval])) or (0 * max by (job, instance, exporter) (otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\",data_type=\"traces\"}))))",
                      "legendFormat": "{{job}} traces",
                      "refId": "C",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "suffix:items/s",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 58,
                  "type": "timeseries",
                  "title": "Sidecar queues by replica · top 20",
                  "description": "Self-telemetry sidecars only. Queues block on overflow. Sustained congestion can cause upstream refusals or timeouts. Compare the busiest replica, not a fleet average. These queues do not include native internal telemetry exporters. Shows up to 20 series with the highest value at the end of the selected range.",
                  "gridPos": {
                    "x": 0,
                    "y": 50,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}) and on (job, instance, exporter, data_type) topk(20, 100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"} @ end() / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"} @ end())",
                      "legendFormat": "{{instance}} · {{exporter}} · {{data_type}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "percent",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 59,
                  "type": "timeseries",
                  "title": "Sidecar traces kept and dropped",
                  "description": "Self-telemetry sidecars only. Tail sampling decisions per second. A trace is kept when a span has an error or lasts longer than 1 second.",
                  "gridPos": {
                    "x": 12,
                    "y": 50,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "sum by (job) (rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\",sampled=\"true\"}[$__rate_interval]))",
                      "legendFormat": "{{job}} kept",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "sum by (job) (rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\",sampled=\"false\"}[$__rate_interval]))",
                      "legendFormat": "{{job}} dropped",
                      "refId": "B",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "suffix:traces/s",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 60,
                  "type": "timeseries",
                  "title": "Sidecar process CPU · top 20",
                  "description": "Self-telemetry sidecars only. CPU consumed by the Collector process. This is separate from container CPU usage and includes no container request or limit comparison. Shows up to 20 replicas.",
                  "gridPos": {
                    "x": 0,
                    "y": 58,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(sum by (job, instance) (rate(otelcol_process_cpu_seconds_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval]))) and on (job, instance) topk(20, sum by (job, instance) (rate(otelcol_process_cpu_seconds_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"}[$__rate_interval] @ end())))",
                      "legendFormat": "{{instance}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "cores",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 61,
                  "type": "timeseries",
                  "title": "Sidecar process RSS · top 20",
                  "description": "Self-telemetry sidecars only. Resident memory of each Collector process. RSS is not the memory limiter heap measurement. Shows up to 20 series with the highest value at the end of the selected range.",
                  "gridPos": {
                    "x": 12,
                    "y": 58,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(max by (job, instance) (otelcol_process_memory_rss_bytes{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"})) and on (job, instance) topk(20, max by (job, instance) (otelcol_process_memory_rss_bytes{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)-sidecar\"} @ end()))",
                      "legendFormat": "{{instance}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "bytes",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                }
              ]
            }
          ]
        }
      nktp-large-target-metrics.json: |
        {
          "uid": "nktp-large-target-metrics",
          "title": "NKTP Large-target Metrics",
          "tags": [
            "nktp",
            "nktp-collector",
            "opentelemetry"
          ],
          "schemaVersion": 39,
          "refresh": "30s",
          "time": {
            "from": "now-30m",
            "to": "now"
          },
          "links": [
            {
              "title": "Collectors",
              "type": "dashboards",
              "tags": [
                "nktp-collector"
              ],
              "asDropdown": true,
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            },
            {
              "title": "NKTP Health",
              "type": "link",
              "url": "/d/nktp-health",
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            }
          ],
          "templating": {
            "list": [
              {
                "name": "namespace",
                "label": "Workload namespace",
                "description": "Filters Kubernetes workload state and namespaced scrape targets. Collector native telemetry has no namespace attribute and covers all NKTP services in the selected datasource.",
                "type": "query",
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "query": "label_values(kube_deployment_spec_replicas{deployment=\"nktp-operator\"}, namespace)",
                "refresh": 1,
                "current": {
                  "text": "nktp",
                  "value": "nktp"
                },
                "multi": false,
                "includeAll": false
              }
            ]
          },
          "panels": [
            {
              "id": 1,
              "type": "row",
              "title": "Pipeline",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 2,
              "type": "timeseries",
              "title": "Received /s",
              "gridPos": {
                "x": 0,
                "y": 1,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-large-target-metrics\"}[5m]))",
                  "legendFormat": "metric points",
                  "refId": "A"
                }
              ],
              "description": "Items received per second across all replicas."
            },
            {
              "id": 3,
              "type": "timeseries",
              "title": "Exported /s",
              "gridPos": {
                "x": 12,
                "y": 1,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_sent_metric_points_total{job=\"nktp-large-target-metrics\"}[5m]))",
                  "legendFormat": "metric points",
                  "refId": "A"
                }
              ],
              "description": "Items exported per second across all replicas."
            },
            {
              "id": 4,
              "type": "timeseries",
              "title": "Export failures /s",
              "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{job=\"nktp-large-target-metrics\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-large-target-metrics\",data_type=\"metrics\"})",
                  "legendFormat": "metric points",
                  "refId": "A"
                }
              ],
              "description": "Items that failed to send, across all replicas. The exporter may retry them."
            },
            {
              "id": 5,
              "type": "timeseries",
              "title": "Refused /s",
              "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_refused_metric_points_total{job=\"nktp-large-target-metrics\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-large-target-metrics\"}[5m]))",
                  "legendFormat": "metric points",
                  "refId": "A"
                }
              ],
              "description": "Items the receivers refused across all replicas, for example under memory pressure."
            },
            {
              "id": 32,
              "type": "timeseries",
              "title": "Received /s by replica · top 20",
              "description": "The 20 replicas that received the most at the end of the range, to show imbalance.",
              "gridPos": {
                "x": 0,
                "y": 15,
                "w": 24,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "(sum by (instance) (rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-large-target-metrics\"}[5m]))) and on (instance) topk(20, sum by (instance) (rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-large-target-metrics\"}[5m] @ end())))",
                  "legendFormat": "{{instance}} metric points",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 6,
              "type": "row",
              "title": "Target Allocator",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 23,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 7,
              "type": "timeseries",
              "title": "Target Allocator collectors",
              "description": "Discovered and allocatable large-target Collectors reported by each Target Allocator replica. A discovered Collector may not yet be allocatable; replica reports are shown separately.",
              "gridPos": {
                "x": 0,
                "y": 24,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "opentelemetry_allocator_collectors_discovered{job=\"nktp-large-target-metrics-targetallocator\"}",
                  "legendFormat": "{{instance}} discovered",
                  "refId": "A"
                },
                {
                  "expr": "opentelemetry_allocator_collectors_allocatable{job=\"nktp-large-target-metrics-targetallocator\"}",
                  "legendFormat": "{{instance}} allocatable",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 8,
              "type": "timeseries",
              "title": "Targets per collector",
              "description": "Targets assigned to each large-target Collector by the Target Allocator. This is an assignment count, not a count of successful scrapes. Multiple allocator replicas may report the same assignments.",
              "gridPos": {
                "x": 12,
                "y": 24,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "opentelemetry_allocator_targets_per_collector{job=\"nktp-large-target-metrics-targetallocator\"}",
                  "legendFormat": "{{collector_name}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 9,
              "type": "timeseries",
              "title": "Target Allocator CPU cores",
              "gridPos": {
                "x": 0,
                "y": 31,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "rate(process_cpu_seconds_total{job=\"nktp-large-target-metrics-targetallocator\"}[5m])",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 10,
              "type": "timeseries",
              "title": "Target Allocator memory (RSS)",
              "gridPos": {
                "x": 12,
                "y": 31,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "process_resident_memory_bytes{job=\"nktp-large-target-metrics-targetallocator\"}",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 11,
              "type": "row",
              "title": "Large targets",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 38,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 12,
              "type": "histogram",
              "title": "Samples per scrape",
              "description": "Latest sample count per target before metric filtering. Sample count indicates scrape work. It does not measure response bytes or memory use.",
              "gridPos": {
                "x": 0,
                "y": 39,
                "w": 24,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "short"
                }
              },
              "options": {
                "combine": true,
                "bucketCount": 20
              },
              "targets": [
                {
                  "expr": "max by (job, instance) (scrape_samples_scraped{nktp_metrics_pool=\"large-target\",job!=\"nktp-large-target-metrics-targetallocator\"})",
                  "refId": "A",
                  "instant": true,
                  "range": false,
                  "format": "table"
                }
              ],
              "transformations": [
                {
                  "id": "filterFieldsByName",
                  "options": {
                    "include": {
                      "names": [
                        "Value"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "id": 13,
              "type": "table",
              "title": "Largest targets by sample count",
              "description": "The 20 targets with the largest latest sample counts, with scrape duration matched by job and instance.",
              "gridPos": {
                "x": 0,
                "y": 46,
                "w": 24,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Samples"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "short"
                      },
                      {
                        "id": "decimals",
                        "value": 0
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Scrape duration"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "s"
                      }
                    ]
                  }
                ]
              },
              "options": {
                "showHeader": true,
                "sortBy": [
                  {
                    "displayName": "Samples",
                    "desc": true
                  }
                ]
              },
              "targets": [
                {
                  "expr": "topk(20, max by (job, instance) (scrape_samples_scraped{nktp_metrics_pool=\"large-target\",job!=\"nktp-large-target-metrics-targetallocator\"}))",
                  "refId": "A",
                  "instant": true,
                  "range": false,
                  "format": "table"
                },
                {
                  "expr": "max by (job, instance) (scrape_duration_seconds{nktp_metrics_pool=\"large-target\",job!=\"nktp-large-target-metrics-targetallocator\"}) and on (job, instance) topk(20, max by (job, instance) (scrape_samples_scraped{nktp_metrics_pool=\"large-target\",job!=\"nktp-large-target-metrics-targetallocator\"}))",
                  "refId": "B",
                  "instant": true,
                  "range": false,
                  "format": "table"
                }
              ],
              "transformations": [
                {
                  "id": "merge",
                  "options": {}
                },
                {
                  "id": "organize",
                  "options": {
                    "excludeByName": {
                      "Time": true
                    },
                    "indexByName": {
                      "job": 0,
                      "instance": 1,
                      "Value #A": 2,
                      "Value #B": 3
                    },
                    "renameByName": {
                      "job": "Job",
                      "instance": "Instance",
                      "Value #A": "Samples",
                      "Value #B": "Scrape duration"
                    }
                  }
                }
              ]
            },
            {
              "id": 14,
              "type": "row",
              "title": "kube-state-metrics scrapes",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 54,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 15,
              "type": "timeseries",
              "title": "KSM samples per scrape · top 20",
              "description": "Samples exposed by each KSM object endpoint. Selects the 20 largest peaks in the chosen range. This measures sample count, not response bytes or memory. Failed scrapes are gaps. Compare changes with scrape duration and the outlier table.",
              "gridPos": {
                "x": 0,
                "y": 55,
                "w": 12,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "targets": [
                {
                  "expr": "(scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 1)) and on (job, instance) topk(20, max_over_time(scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}[$__range] @ end()))",
                  "legendFormat": "{{job}} · {{pod}} · {{instance}}",
                  "refId": "A",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never",
                    "spanNulls": false,
                    "axisBorderShow": false
                  }
                },
                "overrides": []
              },
              "transformations": [
                {
                  "id": "renameByRegex",
                  "options": {
                    "regex": "^nktp-",
                    "renamePattern": ""
                  }
                }
              ],
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "max"
                  ],
                  "sortBy": "Max",
                  "sortDesc": true,
                  "height": 110
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            {
              "id": 16,
              "type": "timeseries",
              "title": "Slowest KSM scrapes · top 20",
              "description": "Duration of KSM object scrape attempts, including failures. Selects the 20 slowest peaks in the selected range, preserving past outliers. The outlier table supplies current Up state. The telemetry endpoint is excluded.",
              "gridPos": {
                "x": 12,
                "y": 55,
                "w": 12,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "targets": [
                {
                  "expr": "scrape_duration_seconds{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) topk(20, max_over_time(scrape_duration_seconds{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}[$__range] @ end()))",
                  "legendFormat": "{{job}} · {{pod}} · {{instance}}",
                  "refId": "A",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never",
                    "spanNulls": false,
                    "axisBorderShow": false
                  }
                },
                "overrides": []
              },
              "transformations": [
                {
                  "id": "renameByRegex",
                  "options": {
                    "regex": "^nktp-",
                    "renamePattern": ""
                  }
                }
              ],
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "max"
                  ],
                  "sortBy": "Max",
                  "sortDesc": true,
                  "height": 110
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            {
              "id": 17,
              "type": "table",
              "title": "KSM largest, growing and failed targets",
              "description": "Up to 20 largest sample counts, 20 fastest-growing counts and 20 failed object endpoints. Sample-count growth estimates the change over the selected range from successful scrapes only. Gauge delta extrapolates across the range. Missing history stays Unknown. A failed scrape can report zero samples and does not establish a small target. Counts are not response bytes or memory.",
              "gridPos": {
                "x": 0,
                "y": 63,
                "w": 24,
                "h": 9
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "targets": [
                {
                  "expr": "max by (target) (label_join((scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) and on (job, instance) (topk(20, scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) or on (job, instance) topk(20, (delta((scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 1))[$__range:1m])) > 0) or on (job, instance) topk(20, up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 0)), \"target\", \" · \", \"job\", \"pod\", \"instance\"))",
                  "instant": true,
                  "range": false,
                  "format": "table",
                  "refId": "A"
                },
                {
                  "expr": "max by (target) (label_join((delta((scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 1))[$__range:1m])) and on (job, instance) (topk(20, scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) or on (job, instance) topk(20, (delta((scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 1))[$__range:1m])) > 0) or on (job, instance) topk(20, up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 0)), \"target\", \" · \", \"job\", \"pod\", \"instance\"))",
                  "instant": true,
                  "range": false,
                  "format": "table",
                  "refId": "B"
                },
                {
                  "expr": "max by (target) (label_join((scrape_duration_seconds{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) and on (job, instance) (topk(20, scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) or on (job, instance) topk(20, (delta((scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 1))[$__range:1m])) > 0) or on (job, instance) topk(20, up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 0)), \"target\", \" · \", \"job\", \"pod\", \"instance\"))",
                  "instant": true,
                  "range": false,
                  "format": "table",
                  "refId": "C"
                },
                {
                  "expr": "max by (target) (label_join((up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) and on (job, instance) (topk(20, scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) or on (job, instance) topk(20, (delta((scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 1))[$__range:1m])) > 0) or on (job, instance) topk(20, up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 0)), \"target\", \" · \", \"job\", \"pod\", \"instance\"))",
                  "instant": true,
                  "range": false,
                  "format": "table",
                  "refId": "D"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ]
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Target"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 650
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Samples"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "short"
                      },
                      {
                        "id": "custom.width",
                        "value": 140
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Sample growth"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "short"
                      },
                      {
                        "id": "custom.width",
                        "value": 140
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Scrape duration"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "s"
                      },
                      {
                        "id": "custom.width",
                        "value": 140
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Up"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "short"
                      },
                      {
                        "id": "custom.width",
                        "value": 140
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Up"
                    },
                    "properties": [
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "0": {
                                "text": "Down",
                                "color": "red"
                              },
                              "1": {
                                "text": "Up",
                                "color": "green"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Target"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 580
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Samples"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 100
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Sample growth"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 150
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Scrape duration"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 120
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Up"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 70
                      }
                    ]
                  }
                ]
              },
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "footer": {
                  "show": false
                },
                "sortBy": [
                  {
                    "displayName": "Up",
                    "desc": false
                  },
                  {
                    "displayName": "Samples",
                    "desc": true
                  }
                ]
              },
              "transformations": [
                {
                  "id": "joinByField",
                  "options": {
                    "byField": "target",
                    "mode": "outerTabular"
                  }
                },
                {
                  "id": "organize",
                  "options": {
                    "excludeByName": {
                      "Time": true,
                      "Time 1": true,
                      "Time 2": true,
                      "Time 3": true
                    },
                    "indexByName": {
                      "target": 0,
                      "Value #D": 1,
                      "Value #A": 2,
                      "Value #B": 3,
                      "Value #C": 4
                    },
                    "renameByName": {
                      "target": "Target",
                      "Value #A": "Samples",
                      "Value #B": "Sample growth",
                      "Value #C": "Scrape duration",
                      "Value #D": "Up"
                    }
                  }
                }
              ]
            },
            {
              "id": 18,
              "type": "timeseries",
              "title": "KSM watch establishment errors",
              "description": "Kubernetes watch establishment errors per KSM group. Zero is shown only when the corresponding watch counter exists. This does not count every error during an established watch.",
              "gridPos": {
                "x": 0,
                "y": 72,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "targets": [
                {
                  "expr": "(sum by (job) (rate(kube_state_metrics_watch_total{job=~\"$namespace/nktp-ksm-.*\",namespace=\"$namespace\",endpoint=\"telemetry\",result=\"error\"}[$__rate_interval]))) or (0 * sum by (job) (rate(kube_state_metrics_watch_total{job=~\"$namespace/nktp-ksm-.*\",namespace=\"$namespace\",endpoint=\"telemetry\"}[$__rate_interval])))",
                  "refId": "A",
                  "instant": false,
                  "range": true,
                  "interval": "1m",
                  "legendFormat": "{{job}} watch"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never",
                    "spanNulls": false,
                    "axisBorderShow": false
                  }
                },
                "overrides": []
              },
              "transformations": [
                {
                  "id": "renameByRegex",
                  "options": {
                    "regex": "^nktp-",
                    "renamePattern": ""
                  }
                }
              ],
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            {
              "id": 19,
              "type": "table",
              "title": "KSM central shard coverage",
              "description": "Each central KSM resource group has its own shard set. Configured comes from the total_shards metric reported by KSM; it is not a Kubernetes desired replica count. Reporting counts distinct shard ordinals with a successful telemetry scrape, so duplicate replicas do not increase coverage. Missing is configured minus reporting. Missing telemetry stays Unknown; workload readiness remains the independent check when a whole group disappears. Scrape coverage does not prove Kubernetes objects are current.",
              "gridPos": {
                "x": 0,
                "y": 79,
                "w": 24,
                "h": 9
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "targets": [
                {
                  "expr": "label_replace((max by (job) (kube_state_metrics_total_shards{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"})), \"target\", \"$1\", \"job\", \"(.+)\")",
                  "refId": "A",
                  "instant": true,
                  "range": false,
                  "interval": "1m",
                  "legendFormat": "",
                  "format": "table"
                },
                {
                  "expr": "label_replace(((count by (job) (count by (job, shard_ordinal) (kube_state_metrics_shard_ordinal{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} == 1)))) or (0 * (count by (job) (up{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"})))), \"target\", \"$1\", \"job\", \"(.+)\")",
                  "refId": "B",
                  "instant": true,
                  "range": false,
                  "interval": "1m",
                  "legendFormat": "",
                  "format": "table"
                },
                {
                  "expr": "label_replace((clamp_min((max by (job) (kube_state_metrics_total_shards{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"})) - ((count by (job) (count by (job, shard_ordinal) (kube_state_metrics_shard_ordinal{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} == 1)))) or (0 * (count by (job) (up{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"})))), 0)), \"target\", \"$1\", \"job\", \"(.+)\")",
                  "refId": "C",
                  "instant": true,
                  "range": false,
                  "interval": "1m",
                  "legendFormat": "",
                  "format": "table"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ]
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Target"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "string"
                      },
                      {
                        "id": "custom.width",
                        "value": 650
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Configured"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "short"
                      },
                      {
                        "id": "custom.width",
                        "value": 130
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Reporting"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "short"
                      },
                      {
                        "id": "custom.width",
                        "value": 130
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Missing"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "short"
                      },
                      {
                        "id": "custom.width",
                        "value": 130
                      }
                    ]
                  }
                ]
              },
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "footer": {
                  "show": false
                },
                "sortBy": [
                  {
                    "displayName": "Target",
                    "desc": false
                  }
                ]
              },
              "transformations": [
                {
                  "id": "joinByField",
                  "options": {
                    "byField": "target",
                    "mode": "outerTabular"
                  }
                },
                {
                  "id": "organize",
                  "options": {
                    "excludeByName": {
                      "Time": true,
                      "Time 1": true,
                      "Time 2": true,
                      "job": true,
                      "job 1": true,
                      "job 2": true
                    },
                    "indexByName": {
                      "target": 0,
                      "Value #A": 1,
                      "Value #B": 2,
                      "Value #C": 3
                    },
                    "renameByName": {
                      "target": "Target",
                      "Value #A": "Configured",
                      "Value #B": "Reporting",
                      "Value #C": "Missing"
                    }
                  }
                }
              ]
            },
            {
              "id": 20,
              "type": "timeseries",
              "title": "KSM node-local coverage",
              "description": "Desired is the KSM pod DaemonSet desired node count. Reporting counts distinct nodes whose KSM telemetry endpoint scrapes successfully. These node-local instances all use shard ordinal 0 and are not one hash-sharded group. Successful telemetry scraping does not prove every Kubernetes object is current.",
              "gridPos": {
                "x": 0,
                "y": 88,
                "w": 24,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "targets": [
                {
                  "expr": "max(kube_daemonset_status_desired_number_scheduled{namespace=\"$namespace\",daemonset=\"nktp-ksm-pods\"})",
                  "refId": "A",
                  "instant": false,
                  "range": true,
                  "interval": "1m",
                  "legendFormat": "Desired nodes"
                },
                {
                  "expr": "(count(count by (k8s_node_name) (up{job=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} == 1))) or (0 * count(up{job=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"}))",
                  "refId": "B",
                  "instant": false,
                  "range": true,
                  "interval": "1m",
                  "legendFormat": "Nodes with successful KSM scrapes"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never",
                    "spanNulls": false,
                    "axisBorderShow": false
                  }
                },
                "overrides": []
              },
              "transformations": [
                {
                  "id": "renameByRegex",
                  "options": {
                    "regex": "^nktp-",
                    "renamePattern": ""
                  }
                }
              ],
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "max"
                  ],
                  "sortBy": "Max",
                  "sortDesc": true,
                  "height": 110
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            {
              "id": 21,
              "type": "row",
              "title": "Queues and resources",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 96,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 22,
              "type": "timeseries",
              "title": "Exporter queue use · top 20",
              "gridPos": {
                "x": 0,
                "y": 97,
                "w": 24,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "percent"
                }
              },
              "targets": [
                {
                  "expr": "100 * (max by (instance, exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-large-target-metrics\"} / otelcol_exporter_queue_capacity{job=\"nktp-large-target-metrics\"})) and on (instance, exporter, data_type) topk(20, max by (instance, exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-large-target-metrics\"} @ end() / otelcol_exporter_queue_capacity{job=\"nktp-large-target-metrics\"} @ end()))",
                  "legendFormat": "{{instance}} {{exporter}} {{data_type}}",
                  "refId": "A"
                }
              ],
              "description": "The 20 fullest exporter queues at the end of the range."
            },
            {
              "id": 23,
              "type": "timeseries",
              "title": "CPU cores · top 20",
              "gridPos": {
                "x": 0,
                "y": 104,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "(sum by (instance) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-large-target-metrics\"}[5m]))) and on (instance) topk(20, sum by (instance) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-large-target-metrics\"}[5m] @ end())))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 24,
              "type": "timeseries",
              "title": "Memory (RSS) · top 20",
              "gridPos": {
                "x": 12,
                "y": 104,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "(sum by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-large-target-metrics\"})) and on (instance) topk(20, sum by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-large-target-metrics\"} @ end()))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 25,
              "type": "row",
              "title": "Self-telemetry sidecar",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 111,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 26,
              "type": "timeseries",
              "title": "Sidecar queue use",
              "description": "Fullest sidecar export queue of any Pod, per signal. The sidecar buffers this Collector's internal telemetry while the watchdog is unavailable.",
              "gridPos": {
                "x": 0,
                "y": 112,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "percent"
                }
              },
              "targets": [
                {
                  "expr": "100 * max by (data_type) (otelcol_exporter_queue_size{job=\"nktp-large-target-metrics-sidecar\"} / otelcol_exporter_queue_capacity{job=\"nktp-large-target-metrics-sidecar\"})",
                  "legendFormat": "{{data_type}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 27,
              "type": "timeseries",
              "title": "Sidecar export failures /s",
              "description": "Internal telemetry that the sidecar failed to send to the watchdog, per signal.",
              "gridPos": {
                "x": 12,
                "y": 112,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{job=\"nktp-large-target-metrics-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-large-target-metrics-sidecar\",data_type=\"metrics\"})",
                  "legendFormat": "metrics",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-large-target-metrics-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-large-target-metrics-sidecar\",data_type=\"logs\"})",
                  "legendFormat": "logs",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_spans_total{job=\"nktp-large-target-metrics-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-large-target-metrics-sidecar\",data_type=\"traces\"})",
                  "legendFormat": "traces",
                  "refId": "C"
                }
              ]
            },
            {
              "id": 28,
              "type": "timeseries",
              "title": "Sidecar refused /s",
              "description": "Internal telemetry that the sidecar refused, per signal, for example under memory pressure.",
              "gridPos": {
                "x": 0,
                "y": 119,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_refused_metric_points_total{job=\"nktp-large-target-metrics-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-large-target-metrics-sidecar\"}[5m]))",
                  "legendFormat": "metrics",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"nktp-large-target-metrics-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-large-target-metrics-sidecar\"}[5m]))",
                  "legendFormat": "logs",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_spans_total{job=\"nktp-large-target-metrics-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_spans_total{job=\"nktp-large-target-metrics-sidecar\"}[5m]))",
                  "legendFormat": "traces",
                  "refId": "C"
                }
              ]
            },
            {
              "id": 29,
              "type": "timeseries",
              "title": "Sidecar traces kept and dropped /s",
              "description": "Tail sampling decisions. A trace is kept when a span has an error or lasts longer than 1 second.",
              "gridPos": {
                "x": 12,
                "y": 119,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-large-target-metrics-sidecar\",sampled=\"true\"}[5m])) or 0 * sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-large-target-metrics-sidecar\",sampled=\"false\"}[5m]))",
                  "legendFormat": "kept",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-large-target-metrics-sidecar\",sampled=\"false\"}[5m]))",
                  "legendFormat": "dropped",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 30,
              "type": "timeseries",
              "title": "Sidecar CPU cores, highest Pod",
              "gridPos": {
                "x": 0,
                "y": 126,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "max(rate(otelcol_process_cpu_seconds_total{job=\"nktp-large-target-metrics-sidecar\"}[5m]))",
                  "legendFormat": "highest Pod",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 31,
              "type": "timeseries",
              "title": "Sidecar memory (RSS), highest Pod",
              "gridPos": {
                "x": 12,
                "y": 126,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "max(otelcol_process_memory_rss_bytes{job=\"nktp-large-target-metrics-sidecar\"})",
                  "legendFormat": "highest Pod",
                  "refId": "A"
                }
              ],
              "description": "Memory of the sidecar that uses the most. Compare it with the sidecar's memory limit."
            }
          ]
        }
      nktp-operator.json: |
        {
          "uid": "nktp-operator",
          "title": "NKTP Operator",
          "description": "OpenTelemetry Operator reconciliation, webhook HTTP traffic and process health. Requires scraped Operator metrics in the selected Prometheus datasource.",
          "tags": ["nktp", "opentelemetry"],
          "schemaVersion": 39,
          "refresh": "30s",
          "time": { "from": "now-30m", "to": "now" },
          "templating": {
            "list": [
              {
                "name": "datasource", "label": "Datasource", "type": "datasource", "query": "prometheus",
                "current": { "text": "prometheus", "value": "prometheus" }
              },
              {
                "name": "job", "label": "Scrape job", "type": "query",
                "datasource": { "type": "prometheus", "uid": "${datasource}" },
                "query": "label_values(controller_runtime_active_workers{controller=\"opentelemetrycollector\"}, job)",
                "refresh": 1, "multi": true, "includeAll": true,
                "current": { "text": "All", "value": "$__all" }
              }
            ]
          },
          "panels": [
            {
              "id": 1, "type": "stat", "title": "Reporting replicas",
              "description": "Operator processes with recent metrics for the selected scrape jobs. This is not the desired or Kubernetes Ready replica count.",
              "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 } },
              "targets": [{ "expr": "count(count by (instance) (process_start_time_seconds{job=~\"$job\"}))", "instant": true, "refId": "A" }]
            },
            {
              "id": 2, "type": "stat", "title": "Leaders",
              "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "targets": [{ "expr": "sum(leader_election_master_status{job=~\"$job\"})", "instant": true, "refId": "A" }]
            },
            {
              "id": 3, "type": "stat", "title": "Reconciliation errors /s",
              "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "targets": [{ "expr": "sum(rate(controller_runtime_reconcile_errors_total{job=~\"$job\"}[$__rate_interval]))", "instant": true, "refId": "A" }]
            },
            {
              "id": 4, "type": "stat", "title": "Webhook HTTP errors /s",
              "description": "HTTP 4xx and 5xx responses from the webhook server.",
              "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "targets": [{ "expr": "sum(rate(controller_runtime_webhook_requests_total{job=~\"$job\",code=~\"[45]..\"}[$__rate_interval])) or (0 * sum(rate(controller_runtime_webhook_requests_total{job=~\"$job\"}[$__rate_interval])))", "instant": true, "refId": "A" }]
            },
            {
              "id": 5, "type": "timeseries", "title": "Reconciliation events",
              "gridPos": { "x": 0, "y": 5, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "interval": "2m",
              "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 80, "barAlignment": -1, "stacking": { "mode": "normal", "group": "reconciliations" } } } },
              "targets": [{ "expr": "sum by (pod, controller, result) (increase(controller_runtime_reconcile_total{job=~\"$job\"}[$__interval]))", "legendFormat": "{{pod}} / {{controller}} / {{result}}", "refId": "A" }]
            },
            {
              "id": 6, "type": "timeseries", "title": "Reconciliation duration p95",
              "gridPos": { "x": 12, "y": 5, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
              "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, pod, controller) (rate(controller_runtime_reconcile_time_seconds_bucket{job=~\"$job\"}[$__rate_interval])))", "legendFormat": "{{pod}} / {{controller}}", "refId": "A" }]
            },
            {
              "id": 7, "type": "timeseries", "title": "Workqueue depth",
              "gridPos": { "x": 0, "y": 12, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [{ "expr": "sum by (name, pod) (workqueue_depth{job=~\"$job\"})", "legendFormat": "{{name}} / {{pod}}", "refId": "A" }]
            },
            {
              "id": 8, "type": "timeseries", "title": "Reconciliation workers",
              "gridPos": { "x": 12, "y": 12, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [
                { "expr": "controller_runtime_active_workers{job=~\"$job\"}", "legendFormat": "{{controller}} / {{pod}} active", "refId": "A" },
                { "expr": "controller_runtime_max_concurrent_reconciles{job=~\"$job\"}", "legendFormat": "{{controller}} / {{pod}} limit", "refId": "B" }
              ]
            },
            {
              "id": 9, "type": "timeseries", "title": "Webhook requests /s",
              "gridPos": { "x": 0, "y": 19, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [{ "expr": "sum by (webhook, code) (rate(controller_runtime_webhook_requests_total{job=~\"$job\"}[$__rate_interval]))", "legendFormat": "{{webhook}} / HTTP {{code}}", "refId": "A" }]
            },
            {
              "id": 10, "type": "timeseries", "title": "Webhook duration p95",
              "gridPos": { "x": 12, "y": 19, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
              "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, pod, webhook) (rate(controller_runtime_webhook_latency_seconds_bucket{job=~\"$job\"}[$__rate_interval])))", "legendFormat": "{{pod}} / {{webhook}}", "refId": "A" }]
            },
            {
              "id": 11, "type": "timeseries", "title": "Operator CPU",
              "gridPos": { "x": 0, "y": 26, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "unit": "cores", "min": 0 } },
              "targets": [{ "expr": "rate(process_cpu_seconds_total{job=~\"$job\"}[$__rate_interval])", "legendFormat": "{{pod}}", "refId": "A" }]
            },
            {
              "id": 12, "type": "timeseries", "title": "Operator memory (RSS)",
              "gridPos": { "x": 12, "y": 26, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 } },
              "targets": [{ "expr": "process_resident_memory_bytes{job=~\"$job\"}", "legendFormat": "{{pod}}", "refId": "A" }]
            }
          ]
        }
      nktp-watchdog.json: |
        {
          "uid": "nktp-watchdog",
          "title": "NKTP Watchdog",
          "tags": [
            "nktp",
            "nktp-collector",
            "opentelemetry"
          ],
          "schemaVersion": 39,
          "refresh": "30s",
          "time": {
            "from": "now-30m",
            "to": "now"
          },
          "links": [
            {
              "title": "Collectors",
              "type": "dashboards",
              "tags": [
                "nktp-collector"
              ],
              "asDropdown": true,
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            },
            {
              "title": "NKTP Health",
              "type": "link",
              "url": "/d/nktp-health",
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            }
          ],
          "templating": {
            "list": []
          },
          "panels": [
            {
              "id": 1,
              "type": "row",
              "title": "Pipeline",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 2,
              "type": "timeseries",
              "title": "Received /s",
              "gridPos": {
                "x": 0,
                "y": 1,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-watchdog\"}[5m]))",
                  "legendFormat": "metric points",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-watchdog\"}[5m]))",
                  "legendFormat": "log records",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_accepted_spans_total{job=\"nktp-watchdog\"}[5m]))",
                  "legendFormat": "spans",
                  "refId": "C"
                }
              ],
              "description": "Items received per second across all replicas."
            },
            {
              "id": 3,
              "type": "timeseries",
              "title": "Exported /s",
              "gridPos": {
                "x": 12,
                "y": 1,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_sent_metric_points_total{job=\"nktp-watchdog\"}[5m]))",
                  "legendFormat": "metric points",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_sent_log_records_total{job=\"nktp-watchdog\"}[5m]))",
                  "legendFormat": "log records",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_sent_spans_total{job=\"nktp-watchdog\"}[5m]))",
                  "legendFormat": "spans",
                  "refId": "C"
                }
              ],
              "description": "Items exported per second across all replicas."
            },
            {
              "id": 4,
              "type": "timeseries",
              "title": "Export failures /s",
              "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{job=\"nktp-watchdog\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-watchdog\",data_type=\"metrics\"})",
                  "legendFormat": "metric points",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-watchdog\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-watchdog\",data_type=\"logs\"})",
                  "legendFormat": "log records",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_spans_total{job=\"nktp-watchdog\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-watchdog\",data_type=\"traces\"})",
                  "legendFormat": "spans",
                  "refId": "C"
                }
              ],
              "description": "Items that failed to send, across all replicas. The exporter may retry them."
            },
            {
              "id": 5,
              "type": "timeseries",
              "title": "Refused /s",
              "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_refused_metric_points_total{job=\"nktp-watchdog\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-watchdog\"}[5m]))",
                  "legendFormat": "metric points",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"nktp-watchdog\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-watchdog\"}[5m]))",
                  "legendFormat": "log records",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_spans_total{job=\"nktp-watchdog\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_spans_total{job=\"nktp-watchdog\"}[5m]))",
                  "legendFormat": "spans",
                  "refId": "C"
                }
              ],
              "description": "Items the receivers refused across all replicas, for example under memory pressure."
            },
            {
              "id": 21,
              "type": "timeseries",
              "title": "Received /s by replica · top 20",
              "description": "The 20 replicas that received the most at the end of the range, to show imbalance.",
              "gridPos": {
                "x": 0,
                "y": 15,
                "w": 24,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "(sum by (instance) (rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-watchdog\"}[5m]))) and on (instance) topk(20, sum by (instance) (rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-watchdog\"}[5m] @ end())))",
                  "legendFormat": "{{instance}} metric points",
                  "refId": "A"
                },
                {
                  "expr": "(sum by (instance) (rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-watchdog\"}[5m]))) and on (instance) topk(20, sum by (instance) (rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-watchdog\"}[5m] @ end())))",
                  "legendFormat": "{{instance}} log records",
                  "refId": "B"
                },
                {
                  "expr": "(sum by (instance) (rate(otelcol_receiver_accepted_spans_total{job=\"nktp-watchdog\"}[5m]))) and on (instance) topk(20, sum by (instance) (rate(otelcol_receiver_accepted_spans_total{job=\"nktp-watchdog\"}[5m] @ end())))",
                  "legendFormat": "{{instance}} spans",
                  "refId": "C"
                }
              ]
            },
            {
              "id": 6,
              "type": "row",
              "title": "Target Allocator and Operator scrape",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 23,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 7,
              "type": "timeseries",
              "title": "Allocator collectors",
              "description": "Sum of discovered and allocatable Watchdog collectors reported by Target Allocator replicas. With multiple allocator replicas, the same collectors may be counted more than once.",
              "gridPos": {
                "x": 0,
                "y": 24,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(opentelemetry_allocator_collectors_discovered{job=\"nktp-watchdog-targetallocator\"})",
                  "legendFormat": "discovered",
                  "refId": "A"
                },
                {
                  "expr": "sum(opentelemetry_allocator_collectors_allocatable{job=\"nktp-watchdog-targetallocator\"})",
                  "legendFormat": "allocatable",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 8,
              "type": "timeseries",
              "title": "Targets per collector",
              "description": "Targets assigned to each Watchdog Collector as reported by the Target Allocator. Each allocator replica can report the same assignment; this is not a count of successful scrapes.",
              "gridPos": {
                "x": 12,
                "y": 24,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "opentelemetry_allocator_targets_per_collector{job=\"nktp-watchdog-targetallocator\"}",
                  "legendFormat": "{{collector_name}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 9,
              "type": "stat",
              "title": "Operator scrape targets up",
              "description": "Number of discovered nktp-operator endpoints whose latest scrape succeeded (up = 1). Other Watchdog inputs are excluded. A positive count can hide failed endpoints; no value means Operator scrape telemetry is absent, not that all targets are healthy.",
              "gridPos": {
                "x": 0,
                "y": 31,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "targets": [
                {
                  "expr": "sum(up{job=\"nktp-operator\"})",
                  "legendFormat": "Operator",
                  "instant": true,
                  "refId": "A"
                }
              ]
            },
            {
              "id": 10,
              "type": "row",
              "title": "Queues and resources",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 38,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 11,
              "type": "timeseries",
              "title": "Exporter queue use · top 20",
              "gridPos": {
                "x": 0,
                "y": 39,
                "w": 24,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "percent"
                }
              },
              "targets": [
                {
                  "expr": "100 * (max by (instance, exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-watchdog\"} / otelcol_exporter_queue_capacity{job=\"nktp-watchdog\"})) and on (instance, exporter, data_type) topk(20, max by (instance, exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-watchdog\"} @ end() / otelcol_exporter_queue_capacity{job=\"nktp-watchdog\"} @ end()))",
                  "legendFormat": "{{instance}} {{exporter}} {{data_type}}",
                  "refId": "A"
                }
              ],
              "description": "The 20 fullest exporter queues at the end of the range."
            },
            {
              "id": 12,
              "type": "timeseries",
              "title": "CPU cores · top 20",
              "gridPos": {
                "x": 0,
                "y": 46,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "(sum by (instance) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-watchdog\"}[5m]))) and on (instance) topk(20, sum by (instance) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-watchdog\"}[5m] @ end())))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 13,
              "type": "timeseries",
              "title": "Memory (RSS) · top 20",
              "gridPos": {
                "x": 12,
                "y": 46,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "(sum by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-watchdog\"})) and on (instance) topk(20, sum by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-watchdog\"} @ end()))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 14,
              "type": "row",
              "title": "Self-telemetry sidecar",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 53,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 15,
              "type": "timeseries",
              "title": "Sidecar queue use",
              "description": "Fullest sidecar export queue of any Pod, per signal. The sidecar buffers this Collector's internal telemetry while the backend is unavailable.",
              "gridPos": {
                "x": 0,
                "y": 54,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "percent"
                }
              },
              "targets": [
                {
                  "expr": "100 * max by (data_type) (otelcol_exporter_queue_size{job=\"nktp-watchdog-sidecar\"} / otelcol_exporter_queue_capacity{job=\"nktp-watchdog-sidecar\"})",
                  "legendFormat": "{{data_type}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 16,
              "type": "timeseries",
              "title": "Sidecar export failures /s",
              "description": "Internal telemetry that the sidecar failed to send to the backend, per signal.",
              "gridPos": {
                "x": 12,
                "y": 54,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{job=\"nktp-watchdog-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-watchdog-sidecar\",data_type=\"metrics\"})",
                  "legendFormat": "metrics",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-watchdog-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-watchdog-sidecar\",data_type=\"logs\"})",
                  "legendFormat": "logs",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_spans_total{job=\"nktp-watchdog-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-watchdog-sidecar\",data_type=\"traces\"})",
                  "legendFormat": "traces",
                  "refId": "C"
                }
              ]
            },
            {
              "id": 17,
              "type": "timeseries",
              "title": "Sidecar refused /s",
              "description": "Internal telemetry that the sidecar refused, per signal, for example under memory pressure.",
              "gridPos": {
                "x": 0,
                "y": 61,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_refused_metric_points_total{job=\"nktp-watchdog-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-watchdog-sidecar\"}[5m]))",
                  "legendFormat": "metrics",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"nktp-watchdog-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-watchdog-sidecar\"}[5m]))",
                  "legendFormat": "logs",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_spans_total{job=\"nktp-watchdog-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_spans_total{job=\"nktp-watchdog-sidecar\"}[5m]))",
                  "legendFormat": "traces",
                  "refId": "C"
                }
              ]
            },
            {
              "id": 18,
              "type": "timeseries",
              "title": "Sidecar traces kept and dropped /s",
              "description": "Tail sampling decisions. A trace is kept when a span has an error or lasts longer than 1 second.",
              "gridPos": {
                "x": 12,
                "y": 61,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-watchdog-sidecar\",sampled=\"true\"}[5m])) or 0 * sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-watchdog-sidecar\",sampled=\"false\"}[5m]))",
                  "legendFormat": "kept",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-watchdog-sidecar\",sampled=\"false\"}[5m]))",
                  "legendFormat": "dropped",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 19,
              "type": "timeseries",
              "title": "Sidecar CPU cores, highest Pod",
              "gridPos": {
                "x": 0,
                "y": 68,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "max(rate(otelcol_process_cpu_seconds_total{job=\"nktp-watchdog-sidecar\"}[5m]))",
                  "legendFormat": "highest Pod",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 20,
              "type": "timeseries",
              "title": "Sidecar memory (RSS), highest Pod",
              "gridPos": {
                "x": 12,
                "y": 68,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "max(otelcol_process_memory_rss_bytes{job=\"nktp-watchdog-sidecar\"})",
                  "legendFormat": "highest Pod",
                  "refId": "A"
                }
              ],
              "description": "Memory of the sidecar that uses the most. Compare it with the sidecar's memory limit."
            }
          ]
        }
      otel-lgtm-health.json: |
        {
          "uid": "otel-lgtm-health",
          "title": "OTel LGTM Health",
          "schemaVersion": 39,
          "refresh": "30s",
          "time": { "from": "now-30m", "to": "now" },
          "panels": [
            {
              "type": "stat",
              "title": "Internal collector up",
              "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "targets": [{ "expr": "sum(up{job=\"otelcol-contrib\"})", "refId": "A" }]
            },
            {
              "type": "timeseries",
              "title": "Received /s",
              "gridPos": { "x": 6, "y": 0, "w": 9, "h": 6 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "targets": [
                { "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total[5m]))", "legendFormat": "metric points", "refId": "A" },
                { "expr": "sum(rate(otelcol_receiver_accepted_log_records_total[5m]))", "legendFormat": "log records", "refId": "B" },
                { "expr": "sum(rate(otelcol_receiver_accepted_spans_total[5m]))", "legendFormat": "spans", "refId": "C" }
              ]
            },
            {
              "type": "timeseries",
              "title": "Exported /s",
              "gridPos": { "x": 15, "y": 0, "w": 9, "h": 6 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "targets": [
                { "expr": "sum(rate(otelcol_exporter_sent_metric_points_total[5m]))", "legendFormat": "metric points", "refId": "A" },
                { "expr": "sum(rate(otelcol_exporter_sent_log_records_total[5m]))", "legendFormat": "log records", "refId": "B" },
                { "expr": "sum(rate(otelcol_exporter_sent_spans_total[5m]))", "legendFormat": "spans", "refId": "C" }
              ]
            },
            {
              "type": "timeseries",
              "title": "Collector memory (RSS)",
              "gridPos": { "x": 0, "y": 6, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "unit": "bytes" } },
              "targets": [{ "expr": "otelcol_process_memory_rss", "legendFormat": "{{job}}", "refId": "A" }]
            },
            {
              "type": "timeseries",
              "title": "Exporter queue size",
              "gridPos": { "x": 12, "y": 6, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "options": { "tooltip": { "mode": "multi" } },
              "targets": [
                { "expr": "otelcol_exporter_queue_size", "legendFormat": "{{data_type}} size", "refId": "A" },
                { "expr": "otelcol_exporter_queue_capacity", "legendFormat": "{{data_type}} capacity", "refId": "B" }
              ]
            }
          ]
        }
    kind: ConfigMap
    metadata:
      name: lgtm-dashboards
      namespace: NAMESPACE
  74: |
    apiVersion: v1
    kind: Service
    metadata:
      name: lgtm
      namespace: NAMESPACE
    spec:
      ports:
        - name: prometheus
          port: 9090
          protocol: TCP
          targetPort: 9090
        - name: grafana
          port: 3000
          protocol: TCP
          targetPort: 3000
        - name: otel-grpc
          port: 4317
          protocol: TCP
          targetPort: 4317
        - name: otel-http
          port: 4318
          protocol: TCP
          targetPort: 4318
      selector:
        app: lgtm
  75: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      name: lgtm
      namespace: NAMESPACE
    spec:
      replicas: 1
      selector:
        matchLabels:
          app: lgtm
      template:
        metadata:
          annotations:
            checksum/dashboards: ebaee50fa7590460dee0ee55af89eea57309d8fec2319ecf1d23fab6ce8defb7
          labels:
            app: lgtm
        spec:
          containers:
            - env:
                - name: GF_AUTH_ANONYMOUS_ENABLED
                  value: "true"
                - name: GF_AUTH_ANONYMOUS_ORG_ROLE
                  value: Admin
                - name: PROMETHEUS_EXTRA_ARGS
                  value: --enable-feature=otlp-deltatocumulative
                - name: GF_PLUGINS_DISABLE_PLUGINS
                  value: stackdriver
              image: grafana/otel-lgtm:0.38.0
              name: lgtm
              ports:
                - containerPort: 3000
                - containerPort: 4317
                - containerPort: 4318
              readinessProbe:
                exec:
                  command:
                    - cat
                    - /tmp/ready
              volumeMounts:
                - mountPath: /otel-lgtm/grafana/conf/provisioning/dashboards/nktp.yaml
                  name: dashboard-provider
                  subPath: nktp.yaml
                - mountPath: /otel-lgtm/grafana/conf/provisioning/dashboards/grafana-dashboards.yaml
                  name: dashboard-provider
                  subPath: wipe-defaults.yaml
                - mountPath: /otel-lgtm/dashboards-nktp
                  name: dashboards
                - mountPath: /data/tempo
                  name: tempo-data
                - mountPath: /data/grafana
                  name: grafana-data
                - mountPath: /data/loki
                  name: loki-data
                - mountPath: /loki
                  name: loki-storage
                - mountPath: /data/prometheus
                  name: p8s-storage
                - mountPath: /data/pyroscope
                  name: pyroscope-storage
          volumes:
            - configMap:
                name: lgtm-dashboard-provider
              name: dashboard-provider
            - configMap:
                name: lgtm-dashboards
              name: dashboards
            - emptyDir: {}
              name: tempo-data
            - emptyDir: {}
              name: loki-data
            - emptyDir: {}
              name: grafana-data
            - emptyDir: {}
              name: loki-storage
            - emptyDir: {}
              name: p8s-storage
            - emptyDir: {}
              name: pyroscope-storage
  76: |
    apiVersion: scheduling.k8s.io/v1
    description: Prioritizes NKTP telemetry below Kubernetes system-critical Pods.
    globalDefault: false
    kind: PriorityClass
    metadata:
      name: nktp-telemetry-critical
    preemptionPolicy: PreemptLowerPriority
    value: 1000000000
  77: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: nktp-watchdog-operator-metrics-NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: nktp-operator-metrics
    subjects:
      - kind: ServiceAccount
        name: nktp-watchdog-collector
        namespace: NAMESPACE
  78: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      name: nktp-watchdog-targetallocator
      namespace: NAMESPACE
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
          - services
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - discovery.k8s.io
        resources:
          - endpointslices
        verbs:
          - get
          - list
          - watch
  79: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      name: nktp-watchdog-targetallocator
      namespace: NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: nktp-watchdog-targetallocator
    subjects:
      - kind: ServiceAccount
        name: nktp-watchdog-targetallocator
        namespace: NAMESPACE
  80: |
    apiVersion: opentelemetry.io/v1beta1
    kind: OpenTelemetryCollector
    metadata:
      labels:
        helm.sh/chart: opentelemetry-kube-stack-0.25.1
      name: nktp-watchdog
      namespace: NAMESPACE
    spec:
      autoscaler:
        behavior:
          scaleUp:
            policies:
              - periodSeconds: 15
                type: Percent
                value: 200
              - periodSeconds: 15
                type: Pods
                value: 8
            selectPolicy: Max
            stabilizationWindowSeconds: 0
        maxReplicas: 16
        minReplicas: 2
        targetCPUUtilization: 75
        targetMemoryUtilization: 75
      config:
        exporters:
          otlp:
            endpoint: lgtm:4317
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              block_on_overflow: true
              num_consumers: 32
              queue_size: 8388608
              sizer: bytes
            tls:
              insecure: true
        extensions:
          health_check:
            endpoint: 0.0.0.0:13133
        processors:
          memory_limiter:
            check_interval: 500ms
            limit_percentage: 80
            spike_limit_percentage: 25
          redaction/basic_v1:
            allow_all_keys: true
            blocked_key_patterns:
              - (?i)(?:(?:^|[._-])(?:password|passwd|secret|token|(?:access|refresh|id|session|auth)[._-]?token|(?:access|secret|private|api)[._-]?key|secret[._-]?access[._-]?key|client[._-]?secret|authorization|(?:set[._-]?)?cookie)|(?-i:[a-z0-9])(?:(?-i:P)(?:assword|asswd|rivate[._-]?key)|(?-i:S)ecret|(?-i:T)oken|(?-i:A)(?:pi[._-]?key|ccess[._-]?key|uthorization)|(?-i:C)ookie))$$
            blocked_values:
              - (?i)\bBearer\s+[A-Za-z0-9._~+/-]+=*
              - (?i)"?\b(?:[A-Za-z0-9]+[._-])*(?:password|passwd|secret|token|(?:access|refresh|id|session|auth)[._-]?token|(?:access|secret|private|api)[._-]?key|secret[._-]?access[._-]?key|client[._-]?secret|authorization|(?:set[._-]?)?cookie|[A-Za-z0-9]*(?-i:[a-z0-9])(?:(?-i:P)(?:assword|asswd|rivate[._-]?key)|(?-i:S)ecret|(?-i:T)oken|(?-i:A)(?:pi[._-]?key|ccess[._-]?key|uthorization)|(?-i:C)ookie))"?\s*[:=]\s*(?:"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|(?:(?:Bearer|Basic)\s+)?[^\s,;"]+)
            redact_all_types: true
            summary: silent
          transform/cluster:
            error_mode: ignore
            log_statements:
              - context: resource
                statements:
                  - set(attributes["k8s.cluster.name"], "${env:K8S_CLUSTER_NAME:-unknown}") where attributes["k8s.cluster.name"] == nil
            metric_statements:
              - context: resource
                statements:
                  - set(attributes["k8s.cluster.name"], "${env:K8S_CLUSTER_NAME:-unknown}") where attributes["k8s.cluster.name"] == nil
            trace_statements:
              - context: resource
                statements:
                  - set(attributes["k8s.cluster.name"], "${env:K8S_CLUSTER_NAME:-unknown}") where attributes["k8s.cluster.name"] == nil
        receivers:
          otlp/insecure:
            protocols:
              grpc:
                endpoint: 0.0.0.0:4320
          otlp/secure:
            protocols:
              grpc:
                endpoint: 0.0.0.0:4317
                keepalive:
                  server_parameters:
                    max_connection_age: 5m
                    max_connection_age_grace: 30s
                tls:
                  cert_file: /etc/nktp/internal-tls/server/tls.crt
                  client_ca_file: /etc/nktp/internal-tls/server/ca.crt
                  key_file: /etc/nktp/internal-tls/server/tls.key
                  reload_interval: 1h
          prometheus:
            config:
              scrape_configs:
                - bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
                  job_name: nktp-operator
                  kubernetes_sd_configs:
                    - namespaces:
                        own_namespace: true
                      role: endpointslice
                  relabel_configs:
                    - action: keep
                      regex: nktp-operator;metrics;true;Pod
                      source_labels:
                        - __meta_kubernetes_service_name
                        - __meta_kubernetes_endpointslice_port_name
                        - __meta_kubernetes_endpointslice_endpoint_conditions_ready
                        - __meta_kubernetes_endpointslice_address_target_kind
                    - source_labels:
                        - __meta_kubernetes_namespace
                      target_label: namespace
                    - source_labels:
                        - __meta_kubernetes_endpointslice_address_target_name
                      target_label: pod
                  scheme: https
                  scrape_interval: 30s
                  tls_config:
                    insecure_skip_verify: true
        service:
          extensions:
            - health_check
          pipelines:
            logs:
              exporters:
                - otlp
              processors:
                - memory_limiter
                - redaction/basic_v1
                - transform/cluster
              receivers:
                - otlp/secure
            metrics:
              exporters:
                - otlp
              processors:
                - memory_limiter
                - redaction/basic_v1
                - transform/cluster
              receivers:
                - otlp/insecure
                - otlp/secure
                - prometheus
            traces:
              exporters:
                - otlp
              processors:
                - memory_limiter
                - redaction/basic_v1
                - transform/cluster
              receivers:
                - otlp/secure
          telemetry:
            logs:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://127.0.0.1:4319
                        protocol: http/protobuf
            metrics:
              readers:
                - periodic:
                    exporter:
                      otlp:
                        endpoint: http://127.0.0.1:4319
                        protocol: http/protobuf
            resource:
              service.instance.id: ${env:POD_NAME}
              service.name: nktp-watchdog
            traces:
              level: basic
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://127.0.0.1:4319
                        protocol: http/protobuf
                    schedule_delay: 1000
      env:
        - name: GOMEMLIMIT
          value: 192MiB
        - name: GOGC
          value: "50"
      image: otel/opentelemetry-collector-k8s:0.162.0
      initContainers:
        - args:
            - --config=yaml:{"exporters":{"otlp":{"endpoint":"lgtm:4317","retry_on_failure":{"max_elapsed_time":"30m"},"sending_queue":{"batch":{"flush_timeout":"1s","max_size":262144,"min_size":65536,"sizer":"bytes"},"block_on_overflow":false,"num_consumers":2,"queue_size":16777216,"sizer":"bytes"},"tls":{"insecure":true}}},"extensions":{"health_check":{"endpoint":"0.0.0.0:13134"}},"processors":{"memory_limiter":{"check_interval":"500ms","limit_percentage":80,"spike_limit_percentage":25},"redaction/basic_v1":{"allow_all_keys":true,"blocked_key_patterns":["(?i)(?:(?:^|[._-])(?:password|passwd|secret|token|(?:access|refresh|id|session|auth)[._-]?token|(?:access|secret|private|api)[._-]?key|secret[._-]?access[._-]?key|client[._-]?secret|authorization|(?:set[._-]?)?cookie)|(?-i:[a-z0-9])(?:(?-i:P)(?:assword|asswd|rivate[._-]?key)|(?-i:S)ecret|(?-i:T)oken|(?-i:A)(?:pi[._-]?key|ccess[._-]?key|uthorization)|(?-i:C)ookie))$$"],"blocked_values":["(?i)\\bBearer\\s+[A-Za-z0-9._~+/-]+=*","(?i)\"?\\b(?:[A-Za-z0-9]+[._-])*(?:password|passwd|secret|token|(?:access|refresh|id|session|auth)[._-]?token|(?:access|secret|private|api)[._-]?key|secret[._-]?access[._-]?key|client[._-]?secret|authorization|(?:set[._-]?)?cookie|[A-Za-z0-9]*(?-i:[a-z0-9])(?:(?-i:P)(?:assword|asswd|rivate[._-]?key)|(?-i:S)ecret|(?-i:T)oken|(?-i:A)(?:pi[._-]?key|ccess[._-]?key|uthorization)|(?-i:C)ookie))\"?\\s*[:=]\\s*(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|(?:(?:Bearer|Basic)\\s+)?[^\\s,;\"]+)"],"redact_all_types":true,"summary":"silent"},"tail_sampling":{"decision_cache":{"sampled_cache_size":50000},"decision_wait":"5s","num_traces":5000,"policies":[{"name":"errors","status_code":{"status_codes":["ERROR"]},"type":"status_code"},{"name":"slow","ottl_condition":{"error_mode":"ignore","span":["end_time_unix_nano - start_time_unix_nano \u003e 1000000000"]},"type":"ottl_condition"}]},"transform/cluster":{"error_mode":"ignore","log_statements":[{"context":"resource","statements":["set(attributes[\"k8s.cluster.name\"], \"${env:K8S_CLUSTER_NAME:-unknown}\") where attributes[\"k8s.cluster.name\"] == nil"]}],"metric_statements":[{"context":"resource","statements":["set(attributes[\"k8s.cluster.name\"], \"${env:K8S_CLUSTER_NAME:-unknown}\") where attributes[\"k8s.cluster.name\"] == nil"]}],"trace_statements":[{"context":"resource","statements":["set(attributes[\"k8s.cluster.name\"], \"${env:K8S_CLUSTER_NAME:-unknown}\") where attributes[\"k8s.cluster.name\"] == nil"]}]}},"receivers":{"otlp":{"protocols":{"http":{"endpoint":"127.0.0.1:4319","keepalive":{"idle_timeout":"5m"}}}}},"service":{"extensions":["health_check"],"pipelines":{"logs":{"exporters":["otlp"],"processors":["memory_limiter","redaction/basic_v1","transform/cluster"],"receivers":["otlp"]},"metrics":{"exporters":["otlp"],"processors":["memory_limiter","redaction/basic_v1","transform/cluster"],"receivers":["otlp"]},"traces":{"exporters":["otlp"],"processors":["memory_limiter","tail_sampling","redaction/basic_v1","transform/cluster"],"receivers":["otlp"]}},"telemetry":{"logs":{"processors":[{"batch":{"exporter":{"otlp":{"endpoint":"http://127.0.0.1:4319","protocol":"http/protobuf"}}}}]},"metrics":{"readers":[{"periodic":{"exporter":{"otlp":{"endpoint":"http://127.0.0.1:4319","protocol":"http/protobuf"}}}}]},"resource":{"service.instance.id":"${env:POD_NAME}","service.name":"nktp-watchdog-sidecar"},"traces":{"level":"none"}}}}
          env:
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: GOMEMLIMIT
              value: 192MiB
          image: otel/opentelemetry-collector-k8s:0.162.0
          livenessProbe:
            httpGet:
              path: /
              port: 13134
          name: otc-sidecar
          resources:
            limits:
              cpu: 200m
              memory: 256Mi
            requests:
              cpu: 20m
              memory: 64Mi
          restartPolicy: Always
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: true
            runAsNonRoot: true
          startupProbe:
            failureThreshold: 30
            httpGet:
              path: /
              port: 13134
            periodSeconds: 1
      managementState: managed
      mode: statefulset
      podDisruptionBudget:
        maxUnavailable: 25%
      podSecurityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      priorityClassName: nktp-telemetry-critical
      replicas: 2
      resources:
        limits:
          cpu: "4"
          memory: 1Gi
        requests:
          cpu: 100m
          memory: 256Mi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
        readOnlyRootFilesystem: true
      targetAllocator:
        allocationStrategy: consistent-hashing
        enabled: true
        env:
          - name: OTEL_SERVICE_NAME
            value: nktp-watchdog-targetallocator
          - name: POD_NAME
            valueFrom:
              fieldRef:
                fieldPath: metadata.name
          - name: OTEL_RESOURCE_ATTRIBUTES
            value: service.instance.id=$(POD_NAME)
        image: ghcr.io/open-telemetry/opentelemetry-operator/target-allocator:0.161.0
        mtls:
          enabled: true
          useCertManager: true
        observability:
          metrics:
            enableMetrics: false
        prometheusCR:
          enabled: false
        replicas: 1
        resources:
          limits:
            cpu: "1"
            memory: 2Gi
          requests:
            cpu: 250m
            memory: 1Gi
        telemetry:
          metrics:
            readers:
              - periodic:
                  exporter:
                    otlpGrpc:
                      endpoint: nktp-watchdog-collector:4320
                      temporalityPreference: cumulative
                      tls:
                        insecure: true
                  interval: 30s
      terminationGracePeriodSeconds: 60
      topologySpreadConstraints:
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-watchdog-collector
          maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-watchdog-collector
          maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
      upgradeStrategy: automatic
      volumeMounts:
        - mountPath: /etc/nktp/internal-tls/server
          name: internal-tls-server
          readOnly: true
      volumes:
        - name: internal-tls-server
          secret:
            items:
              - key: tls.crt
                path: tls.crt
              - key: tls.key
                path: tls.key
              - key: ca.crt
                path: ca.crt
            secretName: nktp-watchdog-server-tls
