                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 31,
                  "type": "timeseries",
                  "title": "Watchdog pipeline queue use",
                  "description": "Watchdog pipeline exporter queue utilization. Watchdog internal telemetry is exported through the watchdog sidecar to the backend and does not pass through these pipeline queues.",
                  "gridPos": {
                    "x": 12,
                    "y": 40,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "100 * otelcol_exporter_queue_size{job=\"nktp-watchdog\"} / otelcol_exporter_queue_capacity{job=\"nktp-watchdog\"}",
                      "legendFormat": "{{instance}} \u00b7 {{data_type}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "percent",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
