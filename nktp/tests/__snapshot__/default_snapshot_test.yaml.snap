                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 53,
                  "type": "timeseries",
                  "title": "Slowest node exporter collectors",
                  "description": "Maximum latest collection duration across node-exporter instances for each collector. A gauge in seconds, including failed collection attempts.",
                  "gridPos": {
                    "x": 12,
                    "y": 39,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "max by (collector) (node_scrape_collector_duration_seconds{job=\"node-exporter\",namespace=\"$namespace\"})",
                      "refId": "A",
                      "instant": false,
                      "range": true,
                      "interval": "1m",
