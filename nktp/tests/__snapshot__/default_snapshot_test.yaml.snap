    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: kube-state-metrics
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: nktp-ksm-cluster
          nktp.nvidia.io/ksm-shard: "0"
      strategy:
        type: Recreate
      template:
        metadata:
          labels:
            app.kubernetes.io/component: kube-state-metrics
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/name: nktp-ksm-cluster
            nktp.nvidia.io/ksm-shard: "0"
        spec:
          containers:
            - args:
                - --resources=nodes,namespaces,storageclasses,resourcequotas,limitranges,leases,certificatesigningrequests,mutatingwebhookconfigurations,validatingadmissionpolicies,validatingadmissionpolicybindings,validatingwebhookconfigurations
                - --auto-gomemlimit
                - --auto-gomemlimit-ratio=0.8
                - --shard=0
                - --total-shards=1
              image: registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.20.0
              livenessProbe:
                httpGet:
                  path: /livez
                  port: http-metrics
                initialDelaySeconds: 5
                timeoutSeconds: 5
              name: kube-state-metrics
              ports:
                - containerPort: 8080
                  name: http-metrics
                - containerPort: 8081
                  name: telemetry
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: telemetry
                initialDelaySeconds: 5
                timeoutSeconds: 5
              resources:
                limits:
                  cpu: "1"
                  memory: 512Mi
                requests:
                  cpu: 100m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsUser: 65534
          nodeSelector:
            kubernetes.io/os: linux
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: nktp-ksm-cluster
