            type: Directory
          name: pod-logs
        - hostPath:
            path: /proc
            type: Directory
          name: host-proc
        - hostPath:
            path: /usr/bin/journalctl
            type: File
          name: journalctl
        - hostPath:
            path: /lib
            type: Directory
          name: host-lib
        - hostPath:
            path: /lib64
            type: DirectoryOrCreate
          name: host-lib64
        - hostPath:
            path: /usr/lib
            type: Directory
          name: host-usr-lib
        - hostPath:
            path: /etc/machine-id
            type: File
          name: host-machine-id
        - hostPath:
            path: /var/log
            type: Directory
          name: host-logs
        - name: internal-tls-client
          secret:
            items:
              - key: tls.crt
                path: tls.crt
              - key: tls.key
                path: tls.key
              - key: ca.crt
                path: ca.crt
            secretName: nktp-daemonset-client-tls
  25: |
    apiVersion: opentelemetry.io/v1beta1
    kind: OpenTelemetryCollector
    metadata:
      labels:
        helm.sh/chart: opentelemetry-kube-stack-0.25.1
      name: nktp-gateway-logs
      namespace: NAMESPACE
    spec:
      autoscaler:
        behavior:
          scaleUp:
            policies:
              - periodSeconds: 15
                type: Percent
                value: 200
              - periodSeconds: 15
                type: Pods
                value: 8
            selectPolicy: Max
            stabilizationWindowSeconds: 0
        maxReplicas: 128
        minReplicas: 2
        targetCPUUtilization: 60
        targetMemoryUtilization: 100
      config:
        exporters:
          otlp:
            endpoint: lgtm:4317
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              block_on_overflow: true
              num_consumers: 32
              queue_size: 515396076
              sizer: bytes
            tls:
              insecure: true
        extensions:
          health_check:
            endpoint: 0.0.0.0:13133
        processors:
          memory_limiter:
            check_interval: 500ms
            limit_percentage: 80
            spike_limit_percentage: 25
          redaction/basic_v1:
            allow_all_keys: true
            blocked_key_patterns:
              - (?i)(?:(?:^|[._-])(?:password|passwd|secret|token|(?:access|refresh|id|session|auth)[._-]?token|(?:access|secret|private|api)[._-]?key|secret[._-]?access[._-]?key|client[._-]?secret|authorization|(?:set[._-]?)?cookie)|(?-i:[a-z0-9])(?:(?-i:P)(?:assword|asswd|rivate[._-]?key)|(?-i:S)ecret|(?-i:T)oken|(?-i:A)(?:pi[._-]?key|ccess[._-]?key|uthorization)|(?-i:C)ookie))$$
            blocked_values:
              - (?i)\bBearer\s+[A-Za-z0-9._~+/-]+=*
              - (?i)"?\b(?:[A-Za-z0-9]+[._-])*(?:password|passwd|secret|token|(?:access|refresh|id|session|auth)[._-]?token|(?:access|secret|private|api)[._-]?key|secret[._-]?access[._-]?key|client[._-]?secret|authorization|(?:set[._-]?)?cookie|[A-Za-z0-9]*(?-i:[a-z0-9])(?:(?-i:P)(?:assword|asswd|rivate[._-]?key)|(?-i:S)ecret|(?-i:T)oken|(?-i:A)(?:pi[._-]?key|ccess[._-]?key|uthorization)|(?-i:C)ookie))"?\s*[:=]\s*(?:"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|(?:(?:Bearer|Basic)\s+)?[^\s,;"]+)
            redact_all_types: true
            summary: silent
          transform/cluster:
            error_mode: ignore
            log_statements:
              - context: resource
                statements:
                  - set(attributes["k8s.cluster.name"], "${env:K8S_CLUSTER_NAME:-unknown}") where attributes["k8s.cluster.name"] == nil
        receivers:
          otlp:
            protocols:
              grpc:
                endpoint: 0.0.0.0:4317
                keepalive:
                  server_parameters:
                    max_connection_age: 1m
                    max_connection_age_grace: 30s
                tls:
                  cert_file: /etc/nktp/internal-tls/server/tls.crt
                  client_ca_file: /etc/nktp/internal-tls/server/ca.crt
                  key_file: /etc/nktp/internal-tls/server/tls.key
                  reload_interval: 1h
        service:
          extensions:
            - health_check
          pipelines:
            logs:
              exporters:
                - otlp
              processors:
                - memory_limiter
                - redaction/basic_v1
                - transform/cluster
              receivers:
                - otlp
          telemetry:
            logs:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://127.0.0.1:4319
                        protocol: http/protobuf
            metrics:
              readers:
                - periodic:
                    exporter:
                      otlp:
                        endpoint: http://127.0.0.1:4319
                        protocol: http/protobuf
            resource:
              service.instance.id: ${env:POD_NAME}
              service.name: nktp-gateway-logs
            traces:
              level: basic
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://127.0.0.1:4319
                        protocol: http/protobuf
                    schedule_delay: 1000
      env:
        - name: GOMEMLIMIT
          value: 1536MiB
        - name: GOGC
          value: "50"
      image: otel/opentelemetry-collector-k8s:0.162.0
      initContainers:
        - args:
            - --config=yaml:{"exporters":{"otlp":{"endpoint":"nktp-watchdog-collector:4317","retry_on_failure":{"max_elapsed_time":"30m"},"sending_queue":{"batch":{"flush_timeout":"1s","max_size":262144,"min_size":65536,"sizer":"bytes"},"block_on_overflow":false,"num_consumers":2,"queue_size":16777216,"sizer":"bytes"},"tls":{"ca_file":"/etc/nktp/internal-tls/client/ca.crt","cert_file":"/etc/nktp/internal-tls/client/tls.crt","key_file":"/etc/nktp/internal-tls/client/tls.key","reload_interval":"1h"}}},"extensions":{"health_check":{"endpoint":"0.0.0.0:13134"}},"processors":{"memory_limiter":{"check_interval":"500ms","limit_percentage":80,"spike_limit_percentage":25},"tail_sampling":{"decision_cache":{"sampled_cache_size":50000},"decision_wait":"5s","num_traces":5000,"policies":[{"name":"errors","status_code":{"status_codes":["ERROR"]},"type":"status_code"},{"name":"slow","ottl_condition":{"error_mode":"ignore","span":["end_time_unix_nano - start_time_unix_nano \u003e 1000000000"]},"type":"ottl_condition"}]}},"receivers":{"otlp":{"protocols":{"http":{"endpoint":"127.0.0.1:4319","keepalive":{"idle_timeout":"5m"}}}}},"service":{"extensions":["health_check"],"pipelines":{"logs":{"exporters":["otlp"],"processors":["memory_limiter"],"receivers":["otlp"]},"metrics":{"exporters":["otlp"],"processors":["memory_limiter"],"receivers":["otlp"]},"traces":{"exporters":["otlp"],"processors":["memory_limiter","tail_sampling"],"receivers":["otlp"]}},"telemetry":{"logs":{"processors":[{"batch":{"exporter":{"otlp":{"endpoint":"http://127.0.0.1:4319","protocol":"http/protobuf"}}}}]},"metrics":{"readers":[{"periodic":{"exporter":{"otlp":{"endpoint":"http://127.0.0.1:4319","protocol":"http/protobuf"}}}}]},"resource":{"service.instance.id":"${env:POD_NAME}","service.name":"nktp-gateway-logs-sidecar"},"traces":{"level":"none"}}}}
          env:
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
