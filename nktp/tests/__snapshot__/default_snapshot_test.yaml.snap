                }
              },
              "targets": [
                {
                  "expr": "(sum by (instance) (rate(otelcol_receiver_accepted_spans_total{job=\"nktp-gateway-traces\"}[5m]))) and on (instance) topk(20, sum by (instance) (rate(otelcol_receiver_accepted_spans_total{job=\"nktp-gateway-traces\"}[5m] @ end())))",
                  "legendFormat": "{{instance}} spans",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 6,
              "type": "row",
              "title": "Queues and resources",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 23,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 7,
              "type": "timeseries",
              "title": "Exporter queue use · top 20",
              "gridPos": {
                "x": 0,
                "y": 24,
                "w": 24,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "percent"
                }
              },
              "targets": [
                {
                  "expr": "100 * (max by (instance, exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-gateway-traces\"} / otelcol_exporter_queue_capacity{job=\"nktp-gateway-traces\"})) and on (instance, exporter, data_type) topk(20, max by (instance, exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-gateway-traces\"} @ end() / otelcol_exporter_queue_capacity{job=\"nktp-gateway-traces\"} @ end()))",
                  "legendFormat": "{{instance}} {{exporter}} {{data_type}}",
                  "refId": "A"
                }
              ],
              "description": "The 20 fullest exporter queues at the end of the range."
            },
            {
              "id": 8,
              "type": "timeseries",
              "title": "CPU cores · top 20",
              "gridPos": {
                "x": 0,
                "y": 31,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "(sum by (instance) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-gateway-traces\"}[5m]))) and on (instance) topk(20, sum by (instance) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-gateway-traces\"}[5m] @ end())))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 9,
              "type": "timeseries",
              "title": "Memory (RSS) · top 20",
              "gridPos": {
                "x": 12,
                "y": 31,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "(sum by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-gateway-traces\"})) and on (instance) topk(20, sum by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-gateway-traces\"} @ end()))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 10,
              "type": "row",
              "title": "Self-telemetry sidecar",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 38,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 11,
              "type": "timeseries",
              "title": "Sidecar queue use",
              "description": "Fullest sidecar export queue of any Pod, per signal. The sidecar buffers this Collector's internal telemetry while the watchdog is unavailable.",
              "gridPos": {
                "x": 0,
                "y": 39,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "percent"
                }
              },
              "targets": [
                {
                  "expr": "100 * max by (data_type) (otelcol_exporter_queue_size{job=\"nktp-gateway-traces-sidecar\"} / otelcol_exporter_queue_capacity{job=\"nktp-gateway-traces-sidecar\"})",
                  "legendFormat": "{{data_type}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 12,
              "type": "timeseries",
              "title": "Sidecar export failures /s",
              "description": "Internal telemetry that the sidecar failed to send to the watchdog, per signal.",
              "gridPos": {
                "x": 12,
                "y": 39,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{job=\"nktp-gateway-traces-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-gateway-traces-sidecar\",data_type=\"metrics\"})",
                  "legendFormat": "metrics",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-gateway-traces-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-gateway-traces-sidecar\",data_type=\"logs\"})",
                  "legendFormat": "logs",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_exporter_send_failed_spans_total{job=\"nktp-gateway-traces-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-gateway-traces-sidecar\",data_type=\"traces\"})",
                  "legendFormat": "traces",
                  "refId": "C"
                }
              ]
            },
            {
              "id": 13,
              "type": "timeseries",
              "title": "Sidecar refused /s",
              "description": "Internal telemetry that the sidecar refused, per signal, for example under memory pressure.",
              "gridPos": {
                "x": 0,
                "y": 46,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_receiver_refused_metric_points_total{job=\"nktp-gateway-traces-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-gateway-traces-sidecar\"}[5m]))",
                  "legendFormat": "metrics",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"nktp-gateway-traces-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-gateway-traces-sidecar\"}[5m]))",
                  "legendFormat": "logs",
                  "refId": "B"
                },
                {
                  "expr": "sum(rate(otelcol_receiver_refused_spans_total{job=\"nktp-gateway-traces-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_spans_total{job=\"nktp-gateway-traces-sidecar\"}[5m]))",
                  "legendFormat": "traces",
                  "refId": "C"
                }
              ]
            },
            {
              "id": 14,
              "type": "timeseries",
              "title": "Sidecar traces kept and dropped /s",
              "description": "Tail sampling decisions. A trace is kept when a span has an error or lasts longer than 1 second.",
              "gridPos": {
                "x": 12,
                "y": 46,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-gateway-traces-sidecar\",sampled=\"true\"}[5m])) or 0 * sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-gateway-traces-sidecar\",sampled=\"false\"}[5m]))",
                  "legendFormat": "kept",
                  "refId": "A"
                },
                {
                  "expr": "sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-gateway-traces-sidecar\",sampled=\"false\"}[5m]))",
                  "legendFormat": "dropped",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 15,
              "type": "timeseries",
              "title": "Sidecar CPU cores, highest Pod",
              "gridPos": {
                "x": 0,
                "y": 53,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "max(rate(otelcol_process_cpu_seconds_total{job=\"nktp-gateway-traces-sidecar\"}[5m]))",
                  "legendFormat": "highest Pod",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 16,
              "type": "timeseries",
              "title": "Sidecar memory (RSS), highest Pod",
              "gridPos": {
                "x": 12,
                "y": 53,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "max(otelcol_process_memory_rss_bytes{job=\"nktp-gateway-traces-sidecar\"})",
                  "legendFormat": "highest Pod",
                  "refId": "A"
                }
              ],
              "description": "Memory of the sidecar that uses the most. Compare it with the sidecar's memory limit."
            }
          ]
        }
      nktp-health.json: |
        {
          "uid": "nktp-health",
          "title": "NKTP Health",
          "description": "Operational health of NKTP workloads and their telemetry pipelines. Start with workload readiness, scrape failures and queue pressure, then inspect faults and each signal path. Missing data is unknown, not healthy. Collector native metrics cover all NKTP services in the selected datasource. Workload namespace filters Kubernetes state and namespaced scrapes.",
          "tags": [
            "nktp",
            "health",
            "opentelemetry"
          ],
          "schemaVersion": 39,
          "version": 1,
          "refresh": "30s",
          "time": {
            "from": "now-30m",
            "to": "now"
          },
          "timezone": "browser",
          "editable": true,
          "graphTooltip": 1,
          "links": [
            {
              "title": "DaemonSet",
              "type": "link",
              "url": "/d/nktp-daemonset",
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            },
            {
              "title": "Metrics",
              "type": "link",
              "url": "/d/nktp-gateway-metrics",
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            },
            {
              "title": "Logs",
              "type": "link",
              "url": "/d/nktp-gateway-logs",
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            },
            {
              "title": "Traces",
              "type": "link",
              "url": "/d/nktp-gateway-traces",
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            },
            {
              "title": "Events",
              "type": "link",
              "url": "/d/nktp-cluster-events",
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            },
            {
              "title": "Large targets",
              "type": "link",
              "url": "/d/nktp-large-target-metrics",
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            },
            {
              "title": "Operator",
              "type": "link",
              "url": "/d/nktp-operator",
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            },
            {
              "title": "Watchdog",
              "type": "link",
              "url": "/d/nktp-watchdog",
              "includeVars": false,
              "keepTime": true,
              "targetBlank": false
            }
          ],
          "templating": {
            "list": [
              {
                "name": "metrics",
                "label": "Metrics",
                "type": "datasource",
                "query": "prometheus",
                "current": {
                  "text": "prometheus",
                  "value": "prometheus"
                },
                "hide": 0
              },
              {
                "name": "logs",
                "label": "Logs",
                "type": "datasource",
                "query": "loki",
                "current": {
                  "text": "loki",
                  "value": "loki"
                },
                "hide": 2
              },
              {
                "name": "traces",
                "label": "Traces",
                "type": "datasource",
                "query": "tempo",
                "current": {
                  "text": "tempo",
                  "value": "tempo"
                },
                "hide": 2
              },
              {
                "name": "namespace",
                "label": "Workload namespace",
                "description": "Filters Kubernetes workload state and namespaced scrape targets. Collector native telemetry has no namespace attribute and covers all NKTP services in the selected datasource.",
                "type": "query",
                "datasource": {
                  "type": "prometheus",
                  "uid": "${metrics}"
                },
                "query": "label_values(kube_deployment_spec_replicas{deployment=\"nktp-operator\"}, namespace)",
                "refresh": 1,
                "current": {
                  "text": "nktp",
                  "value": "nktp"
                },
                "multi": false,
                "includeAll": false
              },
              {
                "name": "component",
                "label": "Resource component",
                "type": "custom",
                "query": "nktp-daemonset-collector,nktp-cluster-events-collector,nktp-gateway-logs-collector,nktp-gateway-metrics-collector,nktp-gateway-traces-collector,nktp-large-target-metrics-collector,nktp-watchdog-collector,nktp-daemonset-targetallocator,nktp-large-target-metrics-targetallocator,nktp-watchdog-targetallocator,nktp-operator,nktp-ksm-pods,nktp-ksm-unscheduled-pods,nktp-ksm-cluster,nktp-ksm-workloads,nktp-ksm-configuration,nktp-ksm-networking,nktp-ksm-storage,nktp-node-exporter,nktp-metrics-server,metrics-server,lgtm",
                "multi": true,
                "includeAll": true,
                "allValue": ".*",
                "current": {
                  "text": "All",
                  "value": "$__all"
                },
                "options": [],
                "hide": 0
              },
              {
                "name": "service",
                "label": "Diagnostic service",
                "description": "Filters the diagnostic logs and internal traces.",
                "type": "custom",
                "query": "nktp-daemonset,nktp-cluster-events,nktp-gateway-logs,nktp-gateway-metrics,nktp-gateway-traces,nktp-large-target-metrics,nktp-watchdog,nktp-daemonset-sidecar,nktp-cluster-events-sidecar,nktp-gateway-logs-sidecar,nktp-gateway-metrics-sidecar,nktp-gateway-traces-sidecar,nktp-large-target-metrics-sidecar,nktp-watchdog-sidecar,nktp-targetallocator,nktp-watchdog-targetallocator,nktp-large-target-metrics-targetallocator,nktp-operator",
                "multi": true,
                "includeAll": true,
                "allValue": "nktp-.*",
                "current": {
                  "text": "All",
                  "value": "$__all"
                }
              },
              {
                "name": "search",
                "label": "Log text",
                "type": "textbox",
                "current": {
                  "text": "",
                  "value": ""
                },
                "options": [
                  {
                    "text": "",
                    "value": ""
                  }
                ]
              }
            ]
          },
          "panels": [
            {
              "id": 1,
              "type": "stat",
              "title": "Unready replicas",
              "description": "Desired replicas minus Ready replicas, clamped at zero for each observed NKTP workload. Covers Collectors, Target Allocators, Operator, kube-state-metrics, node exporter and bundled backend. Unknown means workload metrics are unavailable or an observed workload has no Ready measurement. This does not detect a workload that has been deleted entirely.",
              "gridPos": {
                "x": 0,
                "y": 0,
                "w": 6,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${metrics}"
              },
              "targets": [
                {
                  "expr": "sum(clamp_min((max by (workload) (label_replace(kube_deployment_spec_replicas{namespace=\"$namespace\",deployment=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"deployment\", \"(.+)\")) or max by (workload) (label_replace(kube_statefulset_replicas{namespace=\"$namespace\",statefulset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"statefulset\", \"(.+)\")) or max by (workload) (label_replace(kube_daemonset_status_desired_number_scheduled{namespace=\"$namespace\",daemonset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"daemonset\", \"(.+)\"))) - (max by (workload) (label_replace(kube_deployment_status_replicas_ready{namespace=\"$namespace\",deployment=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"deployment\", \"(.+)\")) or max by (workload) (label_replace(kube_statefulset_status_replicas_ready{namespace=\"$namespace\",statefulset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"statefulset\", \"(.+)\")) or max by (workload) (label_replace(kube_daemonset_status_number_ready{namespace=\"$namespace\",daemonset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"daemonset\", \"(.+)\"))), 0)) and (count((max by (workload) (label_replace(kube_deployment_spec_replicas{namespace=\"$namespace\",deployment=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"deployment\", \"(.+)\")) or max by (workload) (label_replace(kube_statefulset_replicas{namespace=\"$namespace\",statefulset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"statefulset\", \"(.+)\")) or max by (workload) (label_replace(kube_daemonset_status_desired_number_scheduled{namespace=\"$namespace\",daemonset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"daemonset\", \"(.+)\")))) == count((max by (workload) (label_replace(kube_deployment_spec_replicas{namespace=\"$namespace\",deployment=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"deployment\", \"(.+)\")) or max by (workload) (label_replace(kube_statefulset_replicas{namespace=\"$namespace\",statefulset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"statefulset\", \"(.+)\")) or max by (workload) (label_replace(kube_daemonset_status_desired_number_scheduled{namespace=\"$namespace\",daemonset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"daemonset\", \"(.+)\"))) and (max by (workload) (label_replace(kube_deployment_status_replicas_ready{namespace=\"$namespace\",deployment=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"deployment\", \"(.+)\")) or max by (workload) (label_replace(kube_statefulset_status_replicas_ready{namespace=\"$namespace\",statefulset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"statefulset\", \"(.+)\")) or max by (workload) (label_replace(kube_daemonset_status_number_ready{namespace=\"$namespace\",daemonset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"daemonset\", \"(.+)\")))))",
                  "legendFormat": "",
                  "refId": "A",
                  "range": false,
                  "instant": true,
                  "interval": "1m",
                  "format": "table"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "red",
                        "value": 1
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "decimals": 0
                },
                "overrides": []
              },
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto"
              }
            },
            {
              "id": 2,
              "type": "stat",
              "title": "Scrape targets down",
              "description": "Failed current scrapes of Operator, kube-state-metrics, node exporter, kubelet and the bundled backend Collector. Counts both kube-state-metrics endpoints. Target Allocators push metrics and are covered by workload readiness. A missing target is not a successful scrape.",
              "gridPos": {
                "x": 6,
                "y": 0,
                "w": 6,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${metrics}"
              },
              "targets": [
                {
                  "expr": "sum(max by (job, instance, endpoint) ((up{namespace=\"$namespace\",job=~\"$namespace/nktp-.*|nktp-operator|node-exporter\"} or up{job=\"kubelet\"} or up{job=\"otelcol-contrib\"})) == bool 0)",
                  "legendFormat": "",
                  "refId": "A",
                  "range": false,
                  "instant": true,
                  "interval": "1m",
                  "format": "table"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "red",
                        "value": 1
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "decimals": 0
                },
                "overrides": []
              },
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto"
              }
            },
            {
              "id": 3,
              "type": "stat",
              "title": "Highest pipeline queue use",
              "description": "Highest queue utilization of any NKTP Collector replica, exporter and signal. Pipeline exporter queues only. Native internal telemetry SDK queues are separate. Unknown means queue metrics are unavailable.",
              "gridPos": {
                "x": 12,
                "y": 0,
                "w": 6,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${metrics}"
              },
              "targets": [
                {
                  "expr": "max(100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"})",
                  "legendFormat": "",
                  "refId": "A",
                  "range": false,
                  "instant": true,
                  "interval": "1m",
                  "format": "table"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "orange",
                        "value": 70
                      },
                      {
                        "color": "red",
                        "value": 90
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "decimals": 1
                },
                "overrides": []
              },
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto"
              }
            },
            {
              "id": 4,
              "type": "stat",
              "title": "Restarts in selected range",
              "description": "Container restarts reported during the selected time range. Prometheus extrapolates counter increases, so the value can be approximate. A replacement Pod starts a new counter.",
              "gridPos": {
                "x": 18,
                "y": 0,
                "w": 6,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${metrics}"
              },
              "targets": [
                {
                  "expr": "sum(max by (pod, container, uid) (increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\",pod=~\"nktp-.*|lgtm-.*|metrics-server-.*\"}[$__range])))",
                  "legendFormat": "",
                  "refId": "A",
                  "range": false,
                  "instant": true,
                  "interval": "1m",
                  "format": "table"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "red",
                        "value": 1
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "decimals": 0
                },
                "overrides": []
              },
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto"
              }
            },
            {
              "id": 5,
              "type": "table",
              "title": "Workload readiness",
              "description": "All observed NKTP Deployments, StatefulSets and DaemonSets in the selected workload namespace, including each kube-state-metrics group and the bundled backend. Desired and Ready come from Kubernetes state. Blank fields are unavailable. Ready Pods do not establish end-to-end telemetry delivery.",
              "gridPos": {
                "x": 0,
                "y": 4,
                "w": 24,
                "h": 12
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${metrics}"
              },
              "targets": [
                {
                  "expr": "(max by (workload) (label_replace(kube_deployment_spec_replicas{namespace=\"$namespace\",deployment=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"deployment\", \"(.+)\")) or max by (workload) (label_replace(kube_statefulset_replicas{namespace=\"$namespace\",statefulset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"statefulset\", \"(.+)\")) or max by (workload) (label_replace(kube_daemonset_status_desired_number_scheduled{namespace=\"$namespace\",daemonset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"daemonset\", \"(.+)\")))",
                  "legendFormat": "",
                  "refId": "A",
                  "range": false,
                  "instant": true,
                  "interval": "1m",
                  "format": "table"
                },
                {
                  "expr": "(max by (workload) (label_replace(kube_deployment_status_replicas_ready{namespace=\"$namespace\",deployment=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"deployment\", \"(.+)\")) or max by (workload) (label_replace(kube_statefulset_status_replicas_ready{namespace=\"$namespace\",statefulset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"statefulset\", \"(.+)\")) or max by (workload) (label_replace(kube_daemonset_status_number_ready{namespace=\"$namespace\",daemonset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"daemonset\", \"(.+)\")))",
                  "legendFormat": "",
                  "refId": "B",
                  "range": false,
                  "instant": true,
                  "interval": "1m",
                  "format": "table"
                },
                {
                  "expr": "clamp_min((max by (workload) (label_replace(kube_deployment_spec_replicas{namespace=\"$namespace\",deployment=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"deployment\", \"(.+)\")) or max by (workload) (label_replace(kube_statefulset_replicas{namespace=\"$namespace\",statefulset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"statefulset\", \"(.+)\")) or max by (workload) (label_replace(kube_daemonset_status_desired_number_scheduled{namespace=\"$namespace\",daemonset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"daemonset\", \"(.+)\"))) - (max by (workload) (label_replace(kube_deployment_status_replicas_ready{namespace=\"$namespace\",deployment=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"deployment\", \"(.+)\")) or max by (workload) (label_replace(kube_statefulset_status_replicas_ready{namespace=\"$namespace\",statefulset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"statefulset\", \"(.+)\")) or max by (workload) (label_replace(kube_daemonset_status_number_ready{namespace=\"$namespace\",daemonset=~\"nktp-.*|lgtm|metrics-server\"}, \"workload\", \"$1\", \"daemonset\", \"(.+)\"))), 0)",
                  "legendFormat": "",
                  "refId": "C",
                  "range": false,
                  "instant": true,
                  "interval": "1m",
                  "format": "table"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ]
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Workload"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 650
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Unready"
                    },
                    "properties": [
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "color": "green",
                              "value": null
                            },
                            {
                              "color": "red",
                              "value": 1
                            }
                          ]
                        }
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-background"
                        }
                      },
                      {
                        "id": "color",
                        "value": {
                          "mode": "thresholds"
                        }
                      }
                    ]
                  }
                ]
              },
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "footer": {
                  "show": false
                },
                "sortBy": [
                  {
                    "displayName": "Unready",
                    "desc": true
                  },
                  {
                    "displayName": "Workload",
                    "desc": false
                  }
                ]
              },
              "transformations": [
                {
                  "id": "joinByField",
                  "options": {
                    "byField": "workload",
                    "mode": "outerTabular"
                  }
                },
                {
                  "id": "organize",
                  "options": {
                    "excludeByName": {
                      "Time": true,
                      "Time 1": true,
                      "Time 2": true
                    },
                    "indexByName": {
                      "workload": 0,
                      "Value #A": 1,
                      "Value #B": 2,
                      "Value #C": 3
                    },
                    "renameByName": {
                      "workload": "Workload",
                      "Value #A": "Desired",
                      "Value #B": "Ready",
                      "Value #C": "Unready"
                    }
                  }
                }
              ]
            },
            {
              "id": 38,
              "type": "row",
              "title": "Pipeline telemetry across the datasource",
              "collapsed": false,
              "gridPos": {
                "x": 0,
                "y": 16,
                "w": 24,
                "h": 1
              },
              "panels": []
            },
            {
              "id": 6,
              "type": "timeseries",
              "title": "Refused input",
              "description": "Items rejected per second, separated by component and signal. The sender may retry. This is not a permanent-loss count. Zero means no reported failures where matching telemetry is present. Missing telemetry stays unknown.",
              "gridPos": {
                "x": 0,
                "y": 17,
                "w": 8,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${metrics}"
              },
              "targets": [
                {
                  "expr": "(sum by (job) (rate(otelcol_receiver_refused_metric_points_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval])) or 0 * sum by (job) (rate(otelcol_receiver_accepted_metric_points_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval])))",
                  "legendFormat": "{{job}} metrics",
                  "refId": "A",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                },
                {
                  "expr": "(sum by (job) (rate(otelcol_receiver_refused_log_records_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval])) or 0 * sum by (job) (rate(otelcol_receiver_accepted_log_records_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval])))",
                  "legendFormat": "{{job}} logs",
                  "refId": "B",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                },
                {
                  "expr": "(sum by (job) (rate(otelcol_receiver_refused_spans_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval])) or 0 * sum by (job) (rate(otelcol_receiver_accepted_spans_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval])))",
                  "legendFormat": "{{job}} traces",
                  "refId": "C",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "suffix:items/s",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never",
                    "spanNulls": false,
                    "axisBorderShow": false
                  }
                },
                "overrides": []
              },
              "transformations": [
                {
                  "id": "renameByRegex",
                  "options": {
                    "regex": "^nktp-",
                    "renamePattern": ""
                  }
                }
              ],
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "max"
                  ],
                  "sortBy": "Max",
                  "sortDesc": true,
                  "height": 110
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            {
              "id": 7,
              "type": "timeseries",
              "title": "Failed sends",
              "description": "Items per second that exporters failed to send to their destination, separated by component and signal. The exporter may retry them. This is not a permanent-loss count. Zero is anchored to a present exporter queue. Missing telemetry stays unknown.",
              "gridPos": {
                "x": 8,
                "y": 17,
                "w": 8,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${metrics}"
              },
              "targets": [
                {
                  "expr": "sum by (job) ((sum by (job, instance, exporter) (rate(otelcol_exporter_send_failed_metric_points_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval])) or (0 * max by (job, instance, exporter) (otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\",data_type=\"metrics\"}))))",
                  "legendFormat": "{{job}} metrics",
                  "refId": "A",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                },
                {
                  "expr": "sum by (job) ((sum by (job, instance, exporter) (rate(otelcol_exporter_send_failed_log_records_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval])) or (0 * max by (job, instance, exporter) (otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\",data_type=\"logs\"}))))",
                  "legendFormat": "{{job}} logs",
                  "refId": "B",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                },
                {
                  "expr": "sum by (job) ((sum by (job, instance, exporter) (rate(otelcol_exporter_send_failed_spans_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval])) or (0 * max by (job, instance, exporter) (otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\",data_type=\"traces\"}))))",
                  "legendFormat": "{{job}} traces",
                  "refId": "C",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "suffix:items/s",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never",
                    "spanNulls": false,
                    "axisBorderShow": false
                  }
                },
                "overrides": []
              },
              "transformations": [
                {
                  "id": "renameByRegex",
                  "options": {
                    "regex": "^nktp-",
                    "renamePattern": ""
                  }
                }
              ],
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "max"
                  ],
                  "sortBy": "Max",
                  "sortDesc": true,
                  "height": 110
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            {
              "id": 8,
              "type": "timeseries",
              "title": "Enqueue failures",
              "description": "Items per second that exporters could not add to a full sending queue, separated by component and signal. The error returns to the receiver, so a pushing sender may retry. This is not a permanent-loss count. Zero is anchored to a present exporter queue. Missing telemetry stays unknown.",
              "gridPos": {
                "x": 16,
                "y": 17,
                "w": 8,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${metrics}"
              },
              "targets": [
                {
                  "expr": "sum by (job) ((sum by (job, instance, exporter) (rate(otelcol_exporter_enqueue_failed_metric_points_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval])) or (0 * max by (job, instance, exporter) (otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\",data_type=\"metrics\"}))))",
                  "legendFormat": "{{job}} metrics",
                  "refId": "A",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                },
                {
                  "expr": "sum by (job) ((sum by (job, instance, exporter) (rate(otelcol_exporter_enqueue_failed_log_records_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval])) or (0 * max by (job, instance, exporter) (otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\",data_type=\"logs\"}))))",
                  "legendFormat": "{{job}} logs",
                  "refId": "B",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                },
                {
                  "expr": "sum by (job) ((sum by (job, instance, exporter) (rate(otelcol_exporter_enqueue_failed_spans_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval])) or (0 * max by (job, instance, exporter) (otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\",data_type=\"traces\"}))))",
                  "legendFormat": "{{job}} traces",
                  "refId": "C",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "suffix:items/s",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never",
                    "spanNulls": false,
                    "axisBorderShow": false
                  }
                },
                "overrides": []
              },
              "transformations": [
                {
                  "id": "renameByRegex",
                  "options": {
                    "regex": "^nktp-",
                    "renamePattern": ""
                  }
                }
              ],
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "max"
                  ],
                  "sortBy": "Max",
                  "sortDesc": true,
                  "height": 110
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            {
              "id": 9,
              "type": "timeseries",
              "title": "Metrics flow",
              "description": "Metrics items per second at each Collector role. Each hop is shown separately. Do not sum the roles as unique traffic or interpret received minus sent as loss. Idle components can have no samples.",
              "gridPos": {
                "x": 0,
                "y": 25,
                "w": 8,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${metrics}"
              },
              "targets": [
                {
                  "expr": "sum by (job) (rate(otelcol_receiver_accepted_metric_points_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval]))",
                  "legendFormat": "{{job}} received",
                  "refId": "A",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                },
                {
                  "expr": "sum by (job) (rate(otelcol_exporter_sent_metric_points_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval]))",
                  "legendFormat": "{{job}} sent",
                  "refId": "B",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "suffix:points/s",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never",
                    "spanNulls": false,
                    "axisBorderShow": false
                  }
                },
                "overrides": []
              },
              "transformations": [
                {
                  "id": "renameByRegex",
                  "options": {
                    "regex": "^nktp-",
                    "renamePattern": ""
                  }
                }
              ],
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "lastNotNull"
                  ],
                  "height": 110
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            {
              "id": 10,
              "type": "timeseries",
              "title": "Logs flow",
              "description": "Logs items per second at each Collector role. Each hop is shown separately. Do not sum the roles as unique traffic or interpret received minus sent as loss. Idle components can have no samples.",
              "gridPos": {
                "x": 8,
                "y": 25,
                "w": 8,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${metrics}"
              },
              "targets": [
                {
                  "expr": "sum by (job) (rate(otelcol_receiver_accepted_log_records_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval]))",
                  "legendFormat": "{{job}} received",
                  "refId": "A",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                },
                {
                  "expr": "sum by (job) (rate(otelcol_exporter_sent_log_records_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval]))",
                  "legendFormat": "{{job}} sent",
                  "refId": "B",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "suffix:records/s",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never",
                    "spanNulls": false,
                    "axisBorderShow": false
                  }
                },
                "overrides": []
              },
              "transformations": [
                {
                  "id": "renameByRegex",
                  "options": {
                    "regex": "^nktp-",
                    "renamePattern": ""
                  }
                }
              ],
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "lastNotNull"
                  ],
                  "height": 110
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            {
              "id": 11,
              "type": "timeseries",
              "title": "Traces flow",
              "description": "Traces items per second at each Collector role. Each hop is shown separately. Do not sum the roles as unique traffic or interpret received minus sent as loss. Idle components can have no samples.",
              "gridPos": {
                "x": 16,
                "y": 25,
                "w": 8,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${metrics}"
              },
              "targets": [
                {
                  "expr": "sum by (job) (rate(otelcol_receiver_accepted_spans_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval]))",
                  "legendFormat": "{{job}} received",
                  "refId": "A",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                },
                {
                  "expr": "sum by (job) (rate(otelcol_exporter_sent_spans_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval]))",
                  "legendFormat": "{{job}} sent",
                  "refId": "B",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "suffix:spans/s",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never",
                    "spanNulls": false,
                    "axisBorderShow": false
                  }
                },
                "overrides": []
              },
              "transformations": [
                {
                  "id": "renameByRegex",
                  "options": {
                    "regex": "^nktp-",
                    "renamePattern": ""
                  }
                }
              ],
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "lastNotNull"
                  ],
                  "height": 110
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            {
              "id": 42,
              "type": "row",
              "title": "Backpressure and export delay",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 33,
                "w": 24,
                "h": 1
              },
              "panels": [
                {
                  "id": 14,
                  "type": "timeseries",
                  "title": "Pipeline queues by replica \u00b7 top 20",
                  "description": "Queues block on overflow. Sustained congestion can cause upstream refusals or timeouts. Compare the busiest replica, not a fleet average. These queues do not include native internal telemetry exporters. Shows up to 20 series with the highest value at the end of the selected range.",
                  "gridPos": {
                    "x": 0,
                    "y": 34,
                    "w": 24,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}) and on (job, instance, exporter, data_type) topk(20, 100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} @ end() / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} @ end())",
                      "legendFormat": "{{instance}} \u00b7 {{exporter}} \u00b7 {{data_type}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "percent",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 39,
                  "type": "table",
                  "title": "Busiest exporter queues \u00b7 top 20",
                  "description": "Current queue pressure per replica, exporter and signal. NKTP defaults size these queues in serialized bytes. Queue accounting includes in-flight payloads. In-flight counts active export requests, including retry backoff. If the queue sizer is overridden, size and capacity use that configured unit.",
                  "gridPos": {
                    "x": 0,
                    "y": 42,
                    "w": 24,
                    "h": 9
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "max by (target) (label_join((100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}) and on (job, instance, exporter, data_type) (topk(20, 100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"})), \"target\", \" \u00b7 \", \"instance\", \"exporter\", \"data_type\"))",
                      "instant": true,
                      "range": false,
                      "format": "table",
                      "refId": "A"
                    },
                    {
                      "expr": "max by (target) (label_join((otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}) and on (job, instance, exporter, data_type) (topk(20, 100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"})), \"target\", \" \u00b7 \", \"instance\", \"exporter\", \"data_type\"))",
                      "instant": true,
                      "range": false,
                      "format": "table",
                      "refId": "B"
                    },
                    {
                      "expr": "max by (target) (label_join((otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}) and on (job, instance, exporter, data_type) (topk(20, 100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"})), \"target\", \" \u00b7 \", \"instance\", \"exporter\", \"data_type\"))",
                      "instant": true,
                      "range": false,
                      "format": "table",
                      "refId": "C"
                    },
                    {
                      "expr": "max by (target) (label_join((otelcol_exporter_in_flight_requests{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}) and on (job, instance, exporter, data_type) (topk(20, 100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"})), \"target\", \" \u00b7 \", \"instance\", \"exporter\", \"data_type\"))",
                      "instant": true,
                      "range": false,
                      "format": "table",
                      "refId": "D"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ]
                    },
                    "overrides": [
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Target"
                        },
                        "properties": [
                          {
                            "id": "custom.width",
                            "value": 650
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Queue use"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "percent"
                          },
                          {
                            "id": "custom.width",
                            "value": 100
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Used bytes"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "bytes"
                          },
                          {
                            "id": "custom.width",
                            "value": 100
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Capacity"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "bytes"
                          },
                          {
                            "id": "custom.width",
                            "value": 100
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "In flight"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "short"
                          },
                          {
                            "id": "custom.width",
                            "value": 100
                          }
                        ]
                      }
                    ]
                  },
                  "options": {
                    "showHeader": true,
                    "cellHeight": "sm",
                    "footer": {
                      "show": false
                    },
                    "sortBy": [
                      {
                        "displayName": "Queue use",
                        "desc": true
                      }
                    ]
                  },
                  "transformations": [
                    {
                      "id": "joinByField",
                      "options": {
                        "byField": "target",
                        "mode": "outerTabular"
                      }
                    },
                    {
                      "id": "organize",
                      "options": {
                        "excludeByName": {
                          "Time": true,
                          "Time 1": true,
                          "Time 2": true,
                          "Time 3": true
                        },
                        "indexByName": {
                          "target": 0,
                          "Value #A": 1,
                          "Value #B": 2,
                          "Value #C": 3,
                          "Value #D": 4
                        },
                        "renameByName": {
                          "target": "Target",
                          "Value #A": "Queue use",
                          "Value #B": "Used bytes",
                          "Value #C": "Capacity",
                          "Value #D": "In flight"
                        }
                      }
                    }
                  ]
                },
                {
                  "id": 40,
                  "type": "timeseries",
                  "title": "Longest completed export",
                  "description": "Longest observed pipeline export span per time bucket, across replicas of each role. Includes sending and retry backoff. Excludes queue residence and batching before the export starts. Uses completed internal spans, so an export still in progress is not represented. Requires Tempo TraceQL metrics.",
                  "gridPos": {
                    "x": 0,
                    "y": 51,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "tempo",
                    "uid": "${traces}"
                  },
                  "targets": [
                    {
                      "refId": "A",
                      "queryType": "traceql",
                      "metricsQueryType": "range",
                      "query": "{ resource.service.name =~ \"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\" && name =~ \"exporter/.*/.*\" } | max_over_time(duration) by (resource.service.name, span:name)"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "s",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^\\{name=\"([^\"]+)\", resource.service.name=\"nktp-([^\"]+)\"\\}$",
                        "renamePattern": "$2 \u00b7 $1"
                      }
                    },
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^\\{resource.service.name=\"nktp-([^\"]+)\"\\}$",
                        "renamePattern": "$1"
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 41,
                  "type": "timeseries",
                  "title": "Queue admission delay",
                  "description": "Longest observed call to enter an exporter queue, across replicas of each role. Includes blocking while a queue is full. Does not measure time spent waiting after admission. Uses completed internal spans and requires Tempo TraceQL metrics.",
                  "gridPos": {
                    "x": 12,
                    "y": 51,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "tempo",
                    "uid": "${traces}"
                  },
                  "targets": [
                    {
                      "refId": "A",
                      "queryType": "traceql",
                      "metricsQueryType": "range",
                      "query": "{ resource.service.name =~ \"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\" && name = \"exporter/enqueue\" } | max_over_time(duration) by (resource.service.name)"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "s",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^\\{name=\"([^\"]+)\", resource.service.name=\"nktp-([^\"]+)\"\\}$",
                        "renamePattern": "$2 \u00b7 $1"
                      }
                    },
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^\\{resource.service.name=\"nktp-([^\"]+)\"\\}$",
                        "renamePattern": "$1"
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                }
              ]
            },
            {
              "id": 16,
              "type": "row",
              "title": "Container resources, Collector processes and autoscaling",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 34,
                "w": 24,
                "h": 1
              },
              "panels": [
                {
                  "id": 47,
                  "type": "table",
                  "title": "Container CPU budgets \u00b7 up to 3 per component",
                  "description": "Kubernetes requests and limits in the selected namespace. Shows up to 3 containers per component, ranked by request or by limit when no request is reported. Container inventory retains components without budgets. Missing budget values may be unset or unavailable.",
                  "gridPos": {
                    "x": 0,
                    "y": 35,
                    "w": 24,
                    "h": 14
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
