                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
