matches the snapshot with default values:
  1: |
    apiVersion: cert-manager.io/v1
    kind: Issuer
    metadata:
      name: nktp-internal-selfsigned-issuer
      namespace: NAMESPACE
    spec:
      selfSigned: {}
  2: |
    apiVersion: cert-manager.io/v1
    kind: Certificate
    metadata:
      name: nktp-internal-ca
      namespace: NAMESPACE
    spec:
      commonName: nktp-internal-ca
      duration: 43800h
      isCA: true
      issuerRef:
        group: cert-manager.io
        kind: Issuer
        name: nktp-internal-selfsigned-issuer
      privateKey:
        rotationPolicy: Never
      renewBefore: 8760h
      secretName: nktp-internal-ca
      usages:
