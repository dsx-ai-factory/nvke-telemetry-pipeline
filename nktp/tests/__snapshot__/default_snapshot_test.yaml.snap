                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                }
              ]
            },
            {
              "id": 29,
              "type": "row",
              "title": "Operator and kube-state-metrics",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 37,
                "w": 24,
                "h": 1
              },
              "panels": [
                {
                  "id": 23,
                  "type": "timeseries",
                  "title": "Operator reconciliation failures",
                  "description": "Operator reconciliation errors, panics and timeouts. Reconciliation retries can recover. Inspect Operator logs for the affected object.",
                  "gridPos": {
                    "x": 0,
                    "y": 38,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "sum by (controller) (rate(controller_runtime_reconcile_errors_total{job=\"nktp-operator\",namespace=\"$namespace\"}[$__rate_interval]))",
                      "legendFormat": "{{controller}} errors",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "sum by (controller) (rate(controller_runtime_reconcile_panics_total{job=\"nktp-operator\",namespace=\"$namespace\"}[$__rate_interval]))",
                      "legendFormat": "{{controller}} panics",
                      "refId": "B",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "sum by (controller) (rate(controller_runtime_reconcile_timeouts_total{job=\"nktp-operator\",namespace=\"$namespace\"}[$__rate_interval]))",
                      "legendFormat": "{{controller}} timeouts",
                      "refId": "C",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "ops",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 24,
                  "type": "timeseries",
                  "title": "Operator work queue",
                  "description": "Queued controller work. A sustained backlog together with errors or long reconcile times can delay Collector and Target Allocator changes.",
                  "gridPos": {
                    "x": 12,
                    "y": 38,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "max by (name) (workqueue_depth{job=\"nktp-operator\",namespace=\"$namespace\"})",
                      "legendFormat": "{{name}} queued",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 25,
                  "type": "timeseries",
                  "title": "Operator reconcile p95",
                  "description": "The 95th percentile of completed reconciliations. No value is expected when no reconciliations completed in the rate window.",
                  "gridPos": {
                    "x": 0,
                    "y": 45,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "histogram_quantile(0.95, sum by (le, controller) (rate(controller_runtime_reconcile_time_seconds_bucket{job=\"nktp-operator\",namespace=\"$namespace\"}[$__rate_interval])))",
                      "legendFormat": "{{controller}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "s",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
